<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:vm="using:HippoCrm.Desktop.ViewModels" x:Class="HippoCrm.Desktop.Views.TagSelectionWindow" x:DataType="vm:TagSelectionViewModel"
 x:Name="frmTagSelection" Title="{Binding strTitle}" Width="700" Height="650" MinWidth="480" MinHeight="420" WindowStartupLocation="CenterOwner"
 FontFamily="{DynamicResource TacticalFontFamily}" Background="{DynamicResource SystemRegionBrush}" Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}">
 <Grid Margin="24" RowDefinitions="Auto,Auto,Auto,Auto,*,Auto,Auto" RowSpacing="12">
  <Grid ColumnDefinitions="*,Auto"><TextBlock Text="{Binding strTitle}" FontSize="26" FontWeight="Bold" /><Button x:Name="btnCloseTagSelection" Grid.Column="1" Content="Close" IsCancel="True" Click="OnClose" /></Grid>
  <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="12" IsEnabled="{Binding !bLoading}">
   <TextBox x:Name="txtTagSearch" Text="{Binding strSearch, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Watermark="Search tags" AutomationProperties.Name="Search tags" />
   <Button x:Name="btnAddTag" Grid.Column="1" Content="{Binding strAddLabel}" Command="{Binding cmdAddValue}" />
  </Grid>
  <WrapPanel Grid.Row="2" IsEnabled="{Binding !bLoading}">
   <StackPanel Spacing="4" Margin="0,0,12,0"><TextBlock Text="Show" /><ComboBox x:Name="cmbTagSelectionFilter" SelectedIndex="{Binding iSelectionFilter, Mode=TwoWay}" AutomationProperties.Name="Tag selection filter"><ComboBoxItem Content="All" /><ComboBoxItem Content="Selected" /><ComboBoxItem Content="Not selected" /></ComboBox></StackPanel>
   <StackPanel Spacing="4"><TextBlock Text="Sort" /><ComboBox x:Name="cmbTagSort" SelectedIndex="{Binding iSort, Mode=TwoWay}" AutomationProperties.Name="Tag sort order"><ComboBoxItem Content="A–Z" /><ComboBoxItem Content="Z–A" /></ComboBox></StackPanel>
  </WrapPanel>
  <StackPanel Grid.Row="3" Spacing="6"><TextBlock Text="Selected tags" FontWeight="SemiBold" />
   <ScrollViewer MaxHeight="110" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <ItemsControl x:Name="lstSelectedTags" ItemsSource="{Binding lstSelected}" IsEnabled="{Binding !bLoading}">
     <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
     <ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:SelectionValueViewModel">
      <Border CornerRadius="12" Padding="8,4" Margin="0,0,6,6" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
       <StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Text="{Binding strValue}" VerticalAlignment="Center" /><Button x:Name="btnRemoveSelectedTag" Content="Remove" Command="{Binding cmdRemove}" AutomationProperties.Name="{Binding strValue, StringFormat='Remove {0}'}" /></StackPanel>
      </Border>
     </DataTemplate></ItemsControl.ItemTemplate>
    </ItemsControl>
   </ScrollViewer>
  </StackPanel>
  <ListBox x:Name="lstAvailableTags" Grid.Row="4" ItemsSource="{Binding lstVisible}" IsEnabled="{Binding !bLoading}" AutomationProperties.Name="Available tags">
   <ListBox.ItemTemplate><DataTemplate x:DataType="vm:SelectionValueViewModel">
    <CheckBox x:Name="chkSelectTag" IsChecked="{Binding bSelected, Mode=TwoWay}" AutomationProperties.Name="{Binding strValue}">
     <Border CornerRadius="12" Padding="8,4" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"><TextBlock Text="{Binding strValue}" TextAlignment="Center" /></Border>
    </CheckBox>
   </DataTemplate></ListBox.ItemTemplate>
  </ListBox>
  <TextBlock Grid.Row="5" Text="{Binding strStatus}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
  <Button x:Name="btnSaveTagSelection" Grid.Row="6" Content="Save" Click="OnSave" IsEnabled="{Binding !bLoading}" HorizontalAlignment="Right" />
 </Grid>
</Window>

