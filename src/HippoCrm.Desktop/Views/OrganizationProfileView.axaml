<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:vm="using:HippoCrm.Desktop.ViewModels" xmlns:core="using:HippoCrm.Core" xmlns:views="using:HippoCrm.Desktop.Views"
 x:Class="HippoCrm.Desktop.Views.OrganizationProfileView" x:DataType="vm:OrganizationProfileViewModel">
 <UserControl.Styles>
  <Style Selector="TextBlock"><Setter Property="FontSize" Value="16" /><Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" /></Style>
  <Style Selector="Border.profileSection"><Setter Property="Padding" Value="24" /><Setter Property="Margin" Value="0,0,0,16" /><Setter Property="CornerRadius" Value="8" /><Setter Property="BorderThickness" Value="1" /><Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" /><Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" /></Style>
  <Style Selector="Border.profileSection.alternate"><Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorSecondaryBrush}" /></Style>
  <Style Selector="TextBlock.sectionHeading"><Setter Property="FontSize" Value="26" /><Setter Property="FontWeight" Value="Bold" /><Setter Property="Margin" Value="0,0,0,8" /></Style>
  <Style Selector="TextBlock.fieldLabel"><Setter Property="FontSize" Value="13" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseMediumBrush}" /></Style>
  <Style Selector="Button.contentsLink"><Setter Property="FontSize" Value="13" /><Setter Property="Padding" Value="4,6" /><Setter Property="MinHeight" Value="30" /><Setter Property="BorderThickness" Value="0" /><Setter Property="Background" Value="{DynamicResource SystemRegionBrush}" /><Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseMediumHighBrush}" /><Setter Property="HorizontalAlignment" Value="Stretch" /><Setter Property="HorizontalContentAlignment" Value="Left" /></Style>
 </UserControl.Styles>
 <Grid x:Name="grdOrganizationProfile">
  <Grid x:Name="grdOrganizationReadOnly" ColumnDefinitions="*,150" ColumnSpacing="16" IsVisible="{Binding !bEditing}">
   <TabControl x:Name="tcOrgProfileTabs" SelectedIndex="0">
    <TabItem x:Name="tiOverview" Header="Overview">
     <ScrollViewer x:Name="scrOrganizationProfile" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel x:Name="pnlOrganizationSections" Spacing="20">
     <Border x:Name="brdOrgHeader" Classes="profileSection"><StackPanel Spacing="20">
      <Border x:Name="brdOrganizationLogoPlaceholder" Width="64" Height="64" CornerRadius="6" BorderThickness="1" HorizontalAlignment="Left"
              Background="{DynamicResource SystemControlBackgroundChromeLowBrush}" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" AutomationProperties.Name="Organization logo placeholder">
       <TextBlock Text="No Logo" HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Border>
      <TextBlock x:Name="txtOrganizationProfileName" Text="{Binding vmWorkspace.objOrganization.Name}" FontSize="34" FontWeight="Bold" TextWrapping="Wrap" />
     </StackPanel></Border>
     <Border x:Name="brdOrgBasic" Classes="profileSection"><StackPanel Spacing="20"><TextBlock Text="Basic Info" Classes="sectionHeading" /><StackPanel Spacing="6"><TextBlock Text="Email" Classes="fieldLabel" /><ItemsControl x:Name="icEmails" ItemsSource="{Binding lstEmails}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="x:String"><TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,0,0,6" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel>
<StackPanel Spacing="6"><TextBlock Text="Phone" Classes="fieldLabel" /><ItemsControl x:Name="icPhones" ItemsSource="{Binding lstPhones}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="x:String"><TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,0,0,6" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel>
<StackPanel Spacing="6"><TextBlock Text="Address" Classes="fieldLabel" /><ItemsControl x:Name="icAddresses" ItemsSource="{Binding lstAddresses}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="x:String"><TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,0,0,6" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel>
<StackPanel Spacing="6"><TextBlock Text="Status" Classes="fieldLabel" /><TextBlock Text="{Binding vmWorkspace.objOrganization.Status}" TextWrapping="Wrap" /></StackPanel>
<StackPanel Spacing="6"><TextBlock Text="Archived" Classes="fieldLabel" /><TextBlock Text="{Binding vmWorkspace.objOrganization.Archived}" TextWrapping="Wrap" /></StackPanel></StackPanel></Border>
<Border x:Name="brdOrgContacts" Classes="profileSection alternate"><StackPanel Spacing="20"><TextBlock Text="Associated Contacts" Classes="sectionHeading" /><ItemsControl x:Name="lstAssociatedContacts" ItemsSource="{Binding vmWorkspace.lstOrganizationContacts}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="core:Contact">
<Border Padding="0,12" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"><StackPanel Spacing="6">
<TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" /><TextBlock Text="{Binding Email}" TextWrapping="Wrap" /><TextBlock Text="{Binding Phone}" TextWrapping="Wrap" /><TextBlock Text="{Binding Status}" />
</StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
<Border x:Name="brdOrgServices" Classes="profileSection"><StackPanel Spacing="20"><TextBlock Text="Services" Classes="sectionHeading" /><StackPanel Spacing="6"><TextBlock Text="Services / capabilities" Classes="fieldLabel" /><views:TokenChipsView x:Name="ctrReadOnlyOrganizationSkills" lstValues="{Binding vmWorkspace.lstOrganizationSkills}" /></StackPanel></StackPanel></Border>
<Border x:Name="brdOrgTags" Classes="profileSection alternate"><StackPanel Spacing="20"><TextBlock Text="Tags" Classes="sectionHeading" /><views:TokenChipsView x:Name="ctrReadOnlyOrganizationTags" lstValues="{Binding vmWorkspace.lstOrganizationTags}" /></StackPanel></Border>
<Border x:Name="brdOrgNotes" Classes="profileSection"><StackPanel Spacing="20"><TextBlock Text="Notes" Classes="sectionHeading" /><TextBlock Text="Organization notes are not available in this workspace." TextWrapping="Wrap" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" /></StackPanel></Border>
    </StackPanel>
     </ScrollViewer>
    </TabItem>
    <TabItem x:Name="tiLinkedContacts" Header="Contacts">
     <Grid x:Name="grdLinkedContacts" RowDefinitions="Auto,Auto,*" RowSpacing="12" Margin="0,12,0,0">
      <TextBox x:Name="txtContactSearch" Text="{Binding strContactSearch, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
               Watermark="Search linked contacts by name, phone, email, tags, skills or status"
               AutomationProperties.Name="Search this organization's contacts" />
      <TextBlock Grid.Row="1" Text="{Binding strContactSummary}" Classes="fieldLabel" AutomationProperties.LiveSetting="Polite" />
      <ListBox x:Name="lstLinkedContacts" Grid.Row="2" ItemsSource="{Binding lstContactRows}"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled"
               AutomationProperties.Name="Contacts linked to this organization">
       <ListBox.Styles><Style Selector="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /></Style></ListBox.Styles>
       <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:OrganizationProfileViewModel+LinkedContactRowViewModel">
         <Border Padding="8,6" Margin="0,0,0,2" CornerRadius="4" BorderThickness="1"
                 Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
          <Grid ColumnDefinitions="180,*" ColumnSpacing="20">
           <TextBlock Text="{Binding strName}" FontWeight="Bold" TextWrapping="Wrap" />
           <StackPanel Grid.Column="1" Spacing="10">
            <WrapPanel>
             <StackPanel Margin="0,0,20,8"><TextBlock Text="Phone" Classes="fieldLabel" /><TextBlock Text="{Binding strPhone}" TextWrapping="Wrap" /></StackPanel>
             <StackPanel Margin="0,0,20,8"><TextBlock Text="Email" Classes="fieldLabel" /><TextBlock Text="{Binding strEmail}" TextWrapping="Wrap" /></StackPanel>
             <StackPanel Margin="0,0,20,8"><TextBlock Text="Status" Classes="fieldLabel" /><TextBlock Text="{Binding strStatus}" /></StackPanel>
            </WrapPanel>
            <StackPanel Spacing="4"><TextBlock Text="Tags" Classes="fieldLabel" /><views:TokenChipsView x:Name="ctrLinkedContactTags" lstValues="{Binding lstTags}" /></StackPanel>
            <StackPanel Spacing="4"><TextBlock Text="Skills" Classes="fieldLabel" /><views:TokenChipsView x:Name="ctrLinkedContactSkills" lstValues="{Binding lstSkills}" /></StackPanel>
           </StackPanel>
          </Grid>
         </Border>
        </DataTemplate>
       </ListBox.ItemTemplate>
      </ListBox>
     </Grid>
    </TabItem>
   </TabControl>
   <Border x:Name="brdOrganizationContents" Grid.Column="1" Padding="12,4,0,4" BorderThickness="1,0,0,0" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
    <ScrollViewer x:Name="scrOrganizationContents" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
     <StackPanel Spacing="2">
      <TextBlock Text="Contents" FontSize="12" FontWeight="SemiBold" Margin="4,0,0,8" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
      <Button x:Name="btnGobrdOrgHeader" Content="Header" Tag="brdOrgHeader" Classes="contentsLink" Click="OnSectionNavigate" />
<Button x:Name="btnGobrdOrgBasic" Content="Basic Info" Tag="brdOrgBasic" Classes="contentsLink" Click="OnSectionNavigate" />
<Button x:Name="btnGobrdOrgContacts" Content="Associated Contacts" Tag="brdOrgContacts" Classes="contentsLink" Click="OnSectionNavigate" />
<Button x:Name="btnGobrdOrgServices" Content="Services" Tag="brdOrgServices" Classes="contentsLink" Click="OnSectionNavigate" />
<Button x:Name="btnGobrdOrgTags" Content="Tags" Tag="brdOrgTags" Classes="contentsLink" Click="OnSectionNavigate" />
<Button x:Name="btnGobrdOrgNotes" Content="Notes" Tag="brdOrgNotes" Classes="contentsLink" Click="OnSectionNavigate" />
      <Button x:Name="btnEditOrganizationProfile" Content="Edit Profile" Classes="primary" Command="{Binding cmdEdit}" IsEnabled="{Binding vmWorkspace.bCanEditOrganization}" HorizontalAlignment="Stretch" Margin="0,12,0,0" />
     </StackPanel>
    </ScrollViewer>
   </Border>
  </Grid>
  <views:EditOrganizationView x:Name="vEditOrganization" IsVisible="{Binding bEditing}" />
 </Grid>
</UserControl>
