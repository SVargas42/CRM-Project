<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HippoCrm.Desktop.ViewModels" xmlns:core="using:HippoCrm.Core" xmlns:views="using:HippoCrm.Desktop.Views"
             x:Name="ctlContactEditor" x:Class="HippoCrm.Desktop.Views.ContactEditorView" x:DataType="vm:MainWindowViewModel">
  <ScrollViewer x:Name="scrContactEditor" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel x:Name="pnlContactEditor" Spacing="12">
      <TabControl x:Name="tabContactInformation">
        <TabItem Header="Profile">
          <StackPanel Spacing="12" Margin="0,12,0,0">
            <StackPanel Spacing="6"><TextBlock Text="First name *" /><TextBox x:Name="txtFirstName" Tag="First name *" Text="{Binding objContact.FirstName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding !bCanEditContact}" AutomationProperties.Name="First name *" /></StackPanel>
<StackPanel Spacing="6"><TextBlock Text="Last name" /><TextBox x:Name="txtLastName" Tag="Last name" Text="{Binding objContact.LastName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding !bCanEditContact}" AutomationProperties.Name="Last name" /></StackPanel>
            <StackPanel Spacing="6">
              <TextBlock Text="Organizations" />
              <!-- Unset Height uses Avalonia's automatic content sizing. -->
              <ItemsControl x:Name="lstAddedOrganizations" ItemsSource="{Binding lstAddedOrganizations}" AutomationProperties.Name="Assigned contact organizations">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:OrganizationSelectionViewModel">
                    <Border x:Name="bdrAssignedOrganization" CornerRadius="8" Padding="8,4" Margin="0,0,6,6"
                            Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="1">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{Binding strName}" VerticalAlignment="Center" />
                        <Button x:Name="btnRemoveContactOrganization" Content="Remove" Command="{Binding cmdRemove}" IsEnabled="{Binding bCanEdit}"
                                AutomationProperties.Name="{Binding strName, StringFormat='Remove assignment to {0}'}" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Button x:Name="btnShowOrganizationLookup" Content="Add Organization" Classes="primary"
                      Command="{Binding cmdShowOrganizationLookup}" IsEnabled="{Binding bCanEditContact}" />
              <StackPanel x:Name="pnlOrganizationLookup" Spacing="6" IsVisible="{Binding bOrganizationLookup}">
                <AutoCompleteBox x:Name="acbOrganizationSearch" Watermark="Search organizations"
                                 Text="{Binding strOrganizationSearch, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 SelectedItem="{Binding objOrganizationToAdd, Mode=TwoWay}"
                                 AsyncPopulator="{Binding fnPopulateOrganizations}" FilterMode="None"
                                 ValueMemberBinding="{ReflectionBinding strName}" MinimumPrefixLength="1"
                                 MinimumPopulateDelay="0" IsTextCompletionEnabled="False"
                                 HorizontalAlignment="Stretch" AutomationProperties.Name="Search available organizations">
                  <AutoCompleteBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:OrganizationOptionViewModel"><TextBlock Text="{Binding strName}" /></DataTemplate>
                  </AutoCompleteBox.ItemTemplate>
                </AutoCompleteBox>
                <Button x:Name="btnConfirmContactOrganization" Content="Confirm/Add" Command="{Binding cmdAddContactOrganization}" IsEnabled="{Binding bCanAddOrganization}" />
              </StackPanel>
            </StackPanel>
            <StackPanel Spacing="6"><TextBlock Text="Tags" /><views:TokenChipsView x:Name="ctrContactTags" lstValues="{Binding lstContactTags}" /><Button x:Name="btnManageContactTags" Content="Manage Tags" Click="OnManageTags" IsEnabled="{Binding bCanEditContact}" /></StackPanel>
            <StackPanel IsVisible="{Binding !#ctlContactEditor.bEditingMultipleValues}" IsEnabled="{Binding bCanEditContact}"><StackPanel Spacing="6" MaxWidth="480" HorizontalAlignment="Left" DataContext="{Binding vmNewContactEmails}" x:DataType="vm:MultiValueFieldViewModel">
 <TextBlock Text="Emails" />
 <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Spacing="8"><TextBox x:Name="txtNewContactEmail" Width="300" Text="{Binding strNewValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Watermark="Add one entry" AutomationProperties.Name="New Emails" Background="{DynamicResource TextControlBackground}" Foreground="{DynamicResource TextControlForeground}" /><Button x:Name="btnAddContactEmail" Content="Add" Command="{Binding cmdAdd}" AutomationProperties.Name="Add Emails" Background="{DynamicResource ControlFillColorDefaultBrush}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" /></StackPanel>
 <ItemsControl x:Name="icNewContactEmails" Margin="0,12,0,0" ItemsSource="{Binding lstValues}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:MultiValueFieldViewModel+EntryViewModel"><Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4" Padding="12,8" Margin="0,0,0,4"><Grid ColumnDefinitions="*,Auto" ColumnSpacing="8"><TextBlock Grid.Column="0" Text="{Binding strValue}" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" /><Button x:Name="btnRemoveContactEmail" Grid.Column="1" Content="X" Command="{Binding cmdRemove}" VerticalAlignment="Center" MinWidth="32" MinHeight="32" Padding="8,4" CornerRadius="4" BorderThickness="0" Background="{DynamicResource ControlFillColorSecondaryBrush}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" AutomationProperties.Name="{Binding strValue, StringFormat='Remove {0}'}" /></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
 <TextBlock Text="{Binding strError}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
</StackPanel></StackPanel>
<StackPanel IsVisible="{Binding !#ctlContactEditor.bEditingMultipleValues}" IsEnabled="{Binding bCanEditContact}"><StackPanel Spacing="6" MaxWidth="480" HorizontalAlignment="Left" DataContext="{Binding vmNewContactPhones}" x:DataType="vm:MultiValueFieldViewModel">
 <TextBlock Text="Phones" />
 <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Spacing="8"><TextBox x:Name="txtNewContactPhone" Width="300" Text="{Binding strNewValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Watermark="Add one entry" AutomationProperties.Name="New Phones" Background="{DynamicResource TextControlBackground}" Foreground="{DynamicResource TextControlForeground}" /><Button x:Name="btnAddContactPhone" Content="Add" Command="{Binding cmdAdd}" AutomationProperties.Name="Add Phones" Background="{DynamicResource ControlFillColorDefaultBrush}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" /></StackPanel>
 <ItemsControl x:Name="icNewContactPhones" Margin="0,12,0,0" ItemsSource="{Binding lstValues}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:MultiValueFieldViewModel+EntryViewModel"><Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4" Padding="12,8" Margin="0,0,0,4"><Grid ColumnDefinitions="*,Auto" ColumnSpacing="8"><TextBlock Grid.Column="0" Text="{Binding strValue}" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" /><Button x:Name="btnRemoveContactPhone" Grid.Column="1" Content="X" Command="{Binding cmdRemove}" VerticalAlignment="Center" MinWidth="32" MinHeight="32" Padding="8,4" CornerRadius="4" BorderThickness="0" Background="{DynamicResource ControlFillColorSecondaryBrush}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" AutomationProperties.Name="{Binding strValue, StringFormat='Remove {0}'}" /></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
 <TextBlock Text="{Binding strError}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
</StackPanel></StackPanel>
<StackPanel IsVisible="{Binding !#ctlContactEditor.bEditingMultipleValues}" IsEnabled="{Binding bCanEditContact}"><StackPanel Spacing="6" MaxWidth="480" HorizontalAlignment="Left" DataContext="{Binding vmNewContactAddresses}" x:DataType="vm:MultiValueFieldViewModel">
 <TextBlock Text="Addresses" />
 <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Spacing="8"><TextBox x:Name="txtNewContactAddress" Width="300" Text="{Binding strNewValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Watermark="Add one entry" AutomationProperties.Name="New Addresses" Background="{DynamicResource TextControlBackground}" Foreground="{DynamicResource TextControlForeground}" /><Button x:Name="btnAddContactAddress" Content="Add" Command="{Binding cmdAdd}" AutomationProperties.Name="Add Addresses" Background="{DynamicResource ControlFillColorDefaultBrush}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" /></StackPanel>
 <ItemsControl x:Name="icNewContactAddresses" Margin="0,12,0,0" ItemsSource="{Binding lstValues}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:MultiValueFieldViewModel+EntryViewModel"><Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4" Padding="12,8" Margin="0,0,0,4"><Grid ColumnDefinitions="*,Auto" ColumnSpacing="8"><TextBlock Grid.Column="0" Text="{Binding strValue}" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" /><Button x:Name="btnRemoveContactAddress" Grid.Column="1" Content="X" Command="{Binding cmdRemove}" VerticalAlignment="Center" MinWidth="32" MinHeight="32" Padding="8,4" CornerRadius="4" BorderThickness="0" Background="{DynamicResource ControlFillColorSecondaryBrush}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" AutomationProperties.Name="{Binding strValue, StringFormat='Remove {0}'}" /></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
 <TextBlock Text="{Binding strError}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
</StackPanel></StackPanel>
<StackPanel x:Name="pnlDynamicContactDetails" Spacing="12" DataContext="{Binding #ctlContactEditor.vmEditFields}" x:DataType="vm:EditContactViewModel" IsVisible="{Binding #ctlContactEditor.bEditingMultipleValues}" IsEnabled="{Binding vmWorkspace.bCanEditContact}"><StackPanel Spacing="6" MaxWidth="480" HorizontalAlignment="Left" DataContext="{Binding vmEmails}" x:DataType="vm:MultiValueFieldViewModel">
 <TextBlock Text="Emails" />
 <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Spacing="8"><TextBox x:Name="txtNewEmail" Width="300" Text="{Binding strNewValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Watermark="Add one entry" AutomationProperties.Name="New Emails" Background="{DynamicResource TextControlBackground}" Foreground="{DynamicResource TextControlForeground}" /><Button x:Name="btnAddEmail" Content="Add" Command="{Binding cmdAdd}" AutomationProperties.Name="Add Emails" Background="{DynamicResource ControlFillColorDefaultBrush}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" /></StackPanel>
 <ItemsControl x:Name="icEmails" Margin="0,12,0,0" ItemsSource="{Binding lstValues}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:MultiValueFieldViewModel+EntryViewModel"><Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4" Padding="12,8" Margin="0,0,0,4"><Grid ColumnDefinitions="*,Auto" ColumnSpacing="8"><TextBlock Grid.Column="0" Text="{Binding strValue}" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" /><Button x:Name="btnRemoveEmail" Grid.Column="1" Content="X" Command="{Binding cmdRemove}" VerticalAlignment="Center" MinWidth="32" MinHeight="32" Padding="8,4" CornerRadius="4" BorderThickness="0" Background="{DynamicResource ControlFillColorSecondaryBrush}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" AutomationProperties.Name="{Binding strValue, StringFormat='Remove {0}'}" /></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
 <TextBlock Text="{Binding strError}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
</StackPanel><StackPanel Spacing="6" MaxWidth="480" HorizontalAlignment="Left" DataContext="{Binding vmPhones}" x:DataType="vm:MultiValueFieldViewModel">
 <TextBlock Text="Phones" />
 <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Spacing="8"><TextBox x:Name="txtNewPhone" Width="300" Text="{Binding strNewValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Watermark="Add one entry" AutomationProperties.Name="New Phones" Background="{DynamicResource TextControlBackground}" Foreground="{DynamicResource TextControlForeground}" /><Button x:Name="btnAddPhone" Content="Add" Command="{Binding cmdAdd}" AutomationProperties.Name="Add Phones" Background="{DynamicResource ControlFillColorDefaultBrush}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" /></StackPanel>
 <ItemsControl x:Name="icPhones" Margin="0,12,0,0" ItemsSource="{Binding lstValues}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:MultiValueFieldViewModel+EntryViewModel"><Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4" Padding="12,8" Margin="0,0,0,4"><Grid ColumnDefinitions="*,Auto" ColumnSpacing="8"><TextBlock Grid.Column="0" Text="{Binding strValue}" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" /><Button x:Name="btnRemovePhone" Grid.Column="1" Content="X" Command="{Binding cmdRemove}" VerticalAlignment="Center" MinWidth="32" MinHeight="32" Padding="8,4" CornerRadius="4" BorderThickness="0" Background="{DynamicResource ControlFillColorSecondaryBrush}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" AutomationProperties.Name="{Binding strValue, StringFormat='Remove {0}'}" /></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
 <TextBlock Text="{Binding strError}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
</StackPanel><StackPanel Spacing="6" MaxWidth="480" HorizontalAlignment="Left" DataContext="{Binding vmAddresses}" x:DataType="vm:MultiValueFieldViewModel">
 <TextBlock Text="Addresses" />
 <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Spacing="8"><TextBox x:Name="txtNewAddress" Width="300" Text="{Binding strNewValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Watermark="Add one entry" AutomationProperties.Name="New Addresses" Background="{DynamicResource TextControlBackground}" Foreground="{DynamicResource TextControlForeground}" /><Button x:Name="btnAddAddress" Content="Add" Command="{Binding cmdAdd}" AutomationProperties.Name="Add Addresses" Background="{DynamicResource ControlFillColorDefaultBrush}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" /></StackPanel>
 <ItemsControl x:Name="icAddresses" Margin="0,12,0,0" ItemsSource="{Binding lstValues}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:MultiValueFieldViewModel+EntryViewModel"><Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4" Padding="12,8" Margin="0,0,0,4"><Grid ColumnDefinitions="*,Auto" ColumnSpacing="8"><TextBlock Grid.Column="0" Text="{Binding strValue}" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" /><Button x:Name="btnRemoveAddress" Grid.Column="1" Content="X" Command="{Binding cmdRemove}" VerticalAlignment="Center" MinWidth="32" MinHeight="32" Padding="8,4" CornerRadius="4" BorderThickness="0" Background="{DynamicResource ControlFillColorSecondaryBrush}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" AutomationProperties.Name="{Binding strValue, StringFormat='Remove {0}'}" /></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
 <TextBlock Text="{Binding strError}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
</StackPanel></StackPanel><StackPanel Spacing="6"><TextBlock Text="Skills" /><views:TokenChipsView x:Name="ctrContactSkills" lstValues="{Binding lstContactSkills}" /><Button x:Name="btnManageContactSkills" Content="Manage Skills" Click="OnManageSkills" IsEnabled="{Binding bCanEditContact}" /></StackPanel>
            <StackPanel Spacing="6"><TextBlock Text="Status" /><ComboBox x:Name="cboStatus" SelectedItem="{Binding objContact.Status, Mode=TwoWay}" IsEnabled="{Binding bCanEditContact}" AutomationProperties.Name="Status"><ComboBox.Items><x:Static Member="core:RecordStatus.Active" /><x:Static Member="core:RecordStatus.Inactive" /><x:Static Member="core:RecordStatus.Retired" /><x:Static Member="core:RecordStatus.Deceased" /></ComboBox.Items></ComboBox></StackPanel>
            <StackPanel Spacing="6"><TextBlock Text="Contract availability" /><ComboBox x:Name="cboAvailability" SelectedItem="{Binding objContact.Availability, Mode=TwoWay}" IsEnabled="{Binding bCanEditContact}" AutomationProperties.Name="Contract availability"><ComboBox.Items><x:Static Member="core:Availability.Available" /><x:Static Member="core:Availability.Unavailable" /><x:Static Member="core:Availability.Unknown" /></ComboBox.Items></ComboBox></StackPanel>
          </StackPanel>
        </TabItem>
        <TabItem Header="Personal"><StackPanel Spacing="12" Margin="0,12,0,0"><StackPanel Spacing="6"><TextBlock Text="Spouse / partner" /><TextBox x:Name="txtSpouse" Tag="Spouse / partner" Text="{Binding objContact.Spouse, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding !bCanEditContact}" AutomationProperties.Name="Spouse / partner" /></StackPanel>
<StackPanel Spacing="6"><TextBlock Text="Children" /><TextBox x:Name="txtChildren" Tag="Children" Text="{Binding objContact.Children, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding !bCanEditContact}" AutomationProperties.Name="Children" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="85" /></StackPanel>
<StackPanel Spacing="6"><TextBlock Text="Extended family" /><TextBox x:Name="txtFamily" Tag="Extended family" Text="{Binding objContact.Family, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding !bCanEditContact}" AutomationProperties.Name="Extended family" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="85" /></StackPanel>
<StackPanel Spacing="6"><TextBlock Text="Friends" /><TextBox x:Name="txtFriends" Tag="Friends" Text="{Binding objContact.Friends, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding !bCanEditContact}" AutomationProperties.Name="Friends" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="85" /></StackPanel></StackPanel></TabItem>
        <TabItem Header="Social"><StackPanel Spacing="12" Margin="0,12,0,0"><StackPanel Spacing="6"><TextBlock Text="Twitter / X" /><TextBox x:Name="txtTwitter" Tag="Twitter / X" Text="{Binding objContact.Twitter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding !bCanEditContact}" AutomationProperties.Name="Twitter / X" /></StackPanel>
<StackPanel Spacing="6"><TextBlock Text="Instagram" /><TextBox x:Name="txtInstagram" Tag="Instagram" Text="{Binding objContact.Instagram, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding !bCanEditContact}" AutomationProperties.Name="Instagram" /></StackPanel>
<StackPanel Spacing="6"><TextBlock Text="Snapchat" /><TextBox x:Name="txtSnapchat" Tag="Snapchat" Text="{Binding objContact.Snapchat, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding !bCanEditContact}" AutomationProperties.Name="Snapchat" /></StackPanel>
<StackPanel Spacing="6"><TextBlock Text="Facebook" /><TextBox x:Name="txtFacebook" Tag="Facebook" Text="{Binding objContact.Facebook, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding !bCanEditContact}" AutomationProperties.Name="Facebook" /></StackPanel></StackPanel></TabItem>
        <TabItem Header="Interactions" IsVisible="{Binding bSavedContact}">
          <StackPanel Spacing="12" Margin="0,12,0,0">
            <TextBlock Text="Interaction timeline" FontSize="18" />
            <StackPanel Spacing="12" IsVisible="{Binding bCanEditContactHistory}">
              <StackPanel Spacing="6"><TextBlock Text="Interaction note" /><TextBox x:Name="txtInteractionNote" Text="{Binding strNote, Mode=TwoWay}" AutomationProperties.Name="Interaction note" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="85" /></StackPanel>
              <Button x:Name="btnRecordInteraction" Content="Record interaction" Command="{Binding cmdAddInteraction}" Classes="primary" />
            </StackPanel>
            <ItemsControl x:Name="lstContactInteractions" ItemsSource="{Binding lstInteractions}">
              <ItemsControl.ItemTemplate><DataTemplate x:DataType="core:Interaction">
                <Border Padding="12" Margin="0,6" Background="{DynamicResource SystemControlBackgroundAltHighBrush}">
                  <StackPanel Spacing="6"><TextBlock Text="{Binding CreatedAt}" /><TextBlock Text="{Binding Author}" /><TextBlock Text="{Binding Body}" TextWrapping="Wrap" /></StackPanel>
                </Border>
              </DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </TabItem>
        <TabItem Header="Employment" IsVisible="{Binding bSavedContact}">
          <StackPanel Spacing="12" Margin="0,12,0,0">
            <TextBlock Text="Employment history" FontSize="18" />
            <StackPanel Spacing="12" IsVisible="{Binding bCanEditContactHistory}">
              <TextBlock Text="Organization" /><ComboBox x:Name="cboEmployer" ItemsSource="{Binding lstEmployers}" SelectedItem="{Binding objEmployer, Mode=TwoWay}" AutomationProperties.Name="Employer organization" />
              <StackPanel Spacing="6"><TextBlock Text="Role" /><TextBox x:Name="txtEmploymentRole" Text="{Binding strRole, Mode=TwoWay}" AutomationProperties.Name="Role" /></StackPanel>
              <StackPanel Spacing="6"><TextBlock Text="Start (YYYY-MM-DD)" /><TextBox x:Name="txtEmploymentStart" Text="{Binding strStartDate, Mode=TwoWay}" AutomationProperties.Name="Start (YYYY-MM-DD)" /></StackPanel>
              <StackPanel Spacing="6"><TextBlock Text="End (optional)" /><TextBox x:Name="txtEmploymentEnd" Text="{Binding strEndDate, Mode=TwoWay}" AutomationProperties.Name="End (optional)" /></StackPanel>
              <Button x:Name="btnAddPlacement" Content="Add placement" Command="{Binding cmdAddEmployment}" Classes="primary" />
            </StackPanel>
            <ItemsControl x:Name="lstContactEmployment" ItemsSource="{Binding lstEmployment}">
              <ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:EmploymentRowViewModel">
                <Border Padding="12" Margin="0,6" Background="{DynamicResource SystemControlBackgroundAltHighBrush}">
                  <StackPanel Spacing="6">
                    <TextBlock Text="{Binding objEmployment.OrganizationName}" /><TextBlock Text="{Binding objEmployment.Role}" />
                    <TextBlock Text="{Binding objEmployment.Start}" /><TextBlock Text="{Binding objEmployment.End}" />
                    <StackPanel IsVisible="{Binding !objEmployment.End.HasValue}" Spacing="6"
                                IsEnabled="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).bCanEditContactHistory}">
                      <TextBox x:Name="txtPlacementEndDate" Text="{Binding strEndDate, Mode=TwoWay}" AutomationProperties.Name="Placement end date YYYY-MM-DD" />
                      <Button x:Name="btnEndPlacement" Content="End placement" Command="{Binding cmdEnd}" />
                    </StackPanel>
                  </StackPanel>
                </Border>
              </DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </TabItem>
        <TabItem Header="Contracts" IsVisible="{Binding bSavedContact}">
          <StackPanel Spacing="12" Margin="0,12,0,0">
            <TextBlock Text="Contract history" FontSize="18" />
            <StackPanel Spacing="12" IsVisible="{Binding bCanEditContactHistory}">
              <StackPanel Spacing="6"><TextBlock Text="Date (YYYY-MM-DD)" /><TextBox x:Name="txtContractDate" Text="{Binding strContractDate, Mode=TwoWay}" AutomationProperties.Name="Date (YYYY-MM-DD)" /></StackPanel>
              <StackPanel Spacing="6"><TextBlock Text="Contract value" /><TextBox x:Name="txtContractValue" Text="{Binding strContractValue, Mode=TwoWay}" AutomationProperties.Name="Contract value" /></StackPanel>
              <StackPanel Spacing="6"><TextBlock Text="Location" /><TextBox x:Name="txtContractLocation" Text="{Binding strLocation, Mode=TwoWay}" AutomationProperties.Name="Location" /></StackPanel>
              <StackPanel Spacing="6"><TextBlock Text="Description" /><TextBox x:Name="txtContractDescription" Text="{Binding strDescription, Mode=TwoWay}" AutomationProperties.Name="Description" /></StackPanel>
              <Button x:Name="btnAddContract" Content="Add contract" Command="{Binding cmdAddContract}" Classes="primary" />
            </StackPanel>
            <ItemsControl x:Name="lstContactContracts" ItemsSource="{Binding lstContracts}">
              <ItemsControl.ItemTemplate><DataTemplate x:DataType="core:Contract">
                <Border Padding="12" Margin="0,6" Background="{DynamicResource SystemControlBackgroundAltHighBrush}">
                  <StackPanel Spacing="6"><TextBlock Text="{Binding Date}" /><TextBlock Text="{Binding Value}" /><TextBlock Text="{Binding Location}" TextWrapping="Wrap" /><TextBlock Text="{Binding Description}" TextWrapping="Wrap" /></StackPanel>
                </Border>
              </DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </TabItem>
      </TabControl>
        <Button x:Name="btnSaveContact" Content="Save contact" Classes="primary" Command="{Binding cmdSaveContact}" IsEnabled="{Binding bCanEditContact}" IsVisible="{Binding !bSavedContact}" />
    </StackPanel>
  </ScrollViewer>
</UserControl>

