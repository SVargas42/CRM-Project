<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:core="using:HippoCrm.Core" xmlns:views="using:HippoCrm.Desktop.Views" xmlns:vm="using:HippoCrm.Desktop.ViewModels" xmlns:controls="using:HippoCrm.Desktop" x:Class="HippoCrm.Desktop.Views.EditOrganizationView" x:DataType="vm:OrganizationProfileViewModel"><ScrollViewer x:Name="scrOrganizationEdit" IsVisible="{Binding bEditing}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Center">
   <StackPanel x:Name="pnlOrganizationEdit" Spacing="16" Margin="0,0,12,0" MaxWidth="1080" HorizontalAlignment="Stretch">
    <views:ProfilePicturePanel bContact="False" DataContext="{Binding vmWorkspace}" />
    <TextBlock Text="Edit Profile" FontSize="26" FontWeight="Bold" />
    <StackPanel Spacing="6"><TextBlock Text="Organization name *" Classes="fieldLabel" /><controls:CrmTextBox x:Name="txtEditOrganizationName" Classes="fieldWide" Text="{Binding vmWorkspace.objOrganization.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding !vmWorkspace.bCanEditOrganization}" AutomationProperties.Name="Organization name *" /></StackPanel>
<StackPanel IsEnabled="{Binding vmWorkspace.bCanEditOrganization}"><StackPanel Spacing="6" HorizontalAlignment="Stretch" DataContext="{Binding vmEmails}" x:DataType="vm:MultiValueFieldViewModel">
 <TextBlock Text="Emails" />
 <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8"><controls:CrmTextBox x:Name="txtNewEmail" Classes="fieldStandard" Text="{Binding strNewValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Watermark="Add one entry" AutomationProperties.Name="New Emails" Background="{DynamicResource TextControlBackground}" Foreground="{DynamicResource TextControlForeground}"  HorizontalAlignment="Stretch" /><Button Grid.Column="1" x:Name="btnAddEmail" Content="Add" Command="{Binding cmdAdd}" AutomationProperties.Name="Add Emails" Classes="inlineAction" /></Grid>
 <ItemsControl x:Name="icEmails" Margin="0,12,0,0" ItemsSource="{Binding lstValues}" IsVisible="{Binding bHasValues}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:MultiValueFieldViewModel+EntryViewModel"><Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,4"><Grid ColumnDefinitions="*,Auto" ColumnSpacing="8"><TextBlock Grid.Column="0" Text="{Binding strValue}" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" /><Button x:Name="btnRemoveEmail" Grid.Column="1" Content="×" Command="{Binding cmdRemove}" VerticalAlignment="Center" Width="30" MinWidth="30" Height="30" MinHeight="30" Padding="11,4" CornerRadius="6" BorderThickness="0" Background="{DynamicResource ControlFillColorSecondaryBrush}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" AutomationProperties.Name="{Binding strValue, StringFormat='Remove {0}'}" /></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
 <TextBlock Text="{Binding strError}" IsVisible="{Binding bHasError}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
</StackPanel></StackPanel>
<StackPanel IsEnabled="{Binding vmWorkspace.bCanEditOrganization}"><StackPanel Spacing="6" HorizontalAlignment="Stretch" DataContext="{Binding vmPhones}" x:DataType="vm:MultiValueFieldViewModel">
 <TextBlock Text="Phones" />
 <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8"><controls:CrmTextBox x:Name="txtNewPhone" Classes="fieldCompact" Text="{Binding strNewValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Watermark="Add one entry" AutomationProperties.Name="New Phones" Background="{DynamicResource TextControlBackground}" Foreground="{DynamicResource TextControlForeground}"  HorizontalAlignment="Stretch" /><Button Grid.Column="1" x:Name="btnAddPhone" Content="Add" Command="{Binding cmdAdd}" AutomationProperties.Name="Add Phones" Classes="inlineAction" /></Grid>
 <ItemsControl x:Name="icPhones" Margin="0,12,0,0" ItemsSource="{Binding lstValues}" IsVisible="{Binding bHasValues}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:MultiValueFieldViewModel+EntryViewModel"><Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,4"><Grid ColumnDefinitions="*,Auto" ColumnSpacing="8"><TextBlock Grid.Column="0" Text="{Binding strValue}" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" /><Button x:Name="btnRemovePhone" Grid.Column="1" Content="×" Command="{Binding cmdRemove}" VerticalAlignment="Center" Width="30" MinWidth="30" Height="30" MinHeight="30" Padding="11,4" CornerRadius="6" BorderThickness="0" Background="{DynamicResource ControlFillColorSecondaryBrush}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" AutomationProperties.Name="{Binding strValue, StringFormat='Remove {0}'}" /></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
 <TextBlock Text="{Binding strError}" IsVisible="{Binding bHasError}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
</StackPanel></StackPanel>
<StackPanel IsEnabled="{Binding vmWorkspace.bCanEditOrganization}"><StackPanel Spacing="6" HorizontalAlignment="Stretch" DataContext="{Binding vmAddresses}" x:DataType="vm:MultiValueFieldViewModel">
 <TextBlock Text="Addresses" />
 <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8"><controls:CrmTextBox x:Name="txtNewAddress" Classes="fieldWide" Text="{Binding strNewValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Watermark="Add one entry" AutomationProperties.Name="New Addresses" Background="{DynamicResource TextControlBackground}" Foreground="{DynamicResource TextControlForeground}"  HorizontalAlignment="Stretch" /><Button Grid.Column="1" x:Name="btnAddAddress" Content="Add" Command="{Binding cmdAdd}" AutomationProperties.Name="Add Addresses" Classes="inlineAction" /></Grid>
 <ItemsControl x:Name="icAddresses" Margin="0,12,0,0" ItemsSource="{Binding lstValues}" IsVisible="{Binding bHasValues}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:MultiValueFieldViewModel+EntryViewModel"><Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,4"><Grid ColumnDefinitions="*,Auto" ColumnSpacing="8"><TextBlock Grid.Column="0" Text="{Binding strValue}" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" /><Button x:Name="btnRemoveAddress" Grid.Column="1" Content="×" Command="{Binding cmdRemove}" VerticalAlignment="Center" Width="30" MinWidth="30" Height="30" MinHeight="30" Padding="11,4" CornerRadius="6" BorderThickness="0" Background="{DynamicResource ControlFillColorSecondaryBrush}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" AutomationProperties.Name="{Binding strValue, StringFormat='Remove {0}'}" /></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
 <TextBlock Text="{Binding strError}" IsVisible="{Binding bHasError}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
</StackPanel></StackPanel>
<StackPanel Spacing="6"><TextBlock Text="Services" /><views:TokenChipsView x:Name="ctrOrganizationServices" lstValues="{Binding vmWorkspace.lstOrganizationServices}" /><Button Classes="inlineAction" x:Name="btnManageOrganizationServices" Content="Manage Services" Click="OnManageServices" IsEnabled="{Binding vmWorkspace.bCanEditOrganization}" /></StackPanel>
<StackPanel Spacing="6"><TextBlock Text="Tags" /><views:TokenChipsView x:Name="ctrOrganizationTags" lstValues="{Binding vmWorkspace.lstOrganizationTags}" /><Button Classes="inlineAction" x:Name="btnManageOrganizationTags" Content="Manage Tags" Click="OnManageTags" IsEnabled="{Binding vmWorkspace.bCanEditOrganization}" /></StackPanel>
    <StackPanel Orientation="Horizontal" Spacing="12"><Button x:Name="btnSaveOrganizationProfile" Content="Save" Classes="primary" Command="{Binding cmdSave}" IsEnabled="{Binding vmWorkspace.bCanEditOrganization}" /><Button x:Name="btnCancelOrganizationProfile" Content="Cancel" Command="{Binding cmdCancel}" /></StackPanel>
    <Button x:Name="btnArchiveOrganizationProfile" Content="Archive / Restore organization" Command="{Binding cmdArchive}" IsEnabled="{Binding vmWorkspace.bCanEditOrganization}" />
   </StackPanel>
  </ScrollViewer></UserControl>
