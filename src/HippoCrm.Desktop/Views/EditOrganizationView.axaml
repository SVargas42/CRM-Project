<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:core="using:HippoCrm.Core" xmlns:views="using:HippoCrm.Desktop.Views" xmlns:vm="using:HippoCrm.Desktop.ViewModels" x:Class="HippoCrm.Desktop.Views.EditOrganizationView" x:DataType="vm:OrganizationProfileViewModel"><ScrollViewer x:Name="scrOrganizationEdit" IsVisible="{Binding bEditing}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <StackPanel x:Name="pnlOrganizationEdit" Spacing="16">
    <TextBlock Text="Edit Profile" FontSize="26" FontWeight="Bold" />
    <StackPanel Spacing="6"><TextBlock Text="Organization name *" Classes="fieldLabel" /><TextBox x:Name="txtEditOrganizationName" Text="{Binding vmWorkspace.objOrganization.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding !vmWorkspace.bCanEditOrganization}" AutomationProperties.Name="Organization name *" /></StackPanel>
<StackPanel IsEnabled="{Binding vmWorkspace.bCanEditOrganization}"><StackPanel Spacing="6" MaxWidth="480" HorizontalAlignment="Left" DataContext="{Binding vmEmails}" x:DataType="vm:MultiValueFieldViewModel">
 <TextBlock Text="Emails" />
 <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Spacing="8"><TextBox x:Name="txtNewEmail" Width="300" Text="{Binding strNewValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Watermark="Add one entry" AutomationProperties.Name="New Emails" Background="{DynamicResource TextControlBackground}" Foreground="{DynamicResource TextControlForeground}" /><Button x:Name="btnAddEmail" Content="Add" Command="{Binding cmdAdd}" AutomationProperties.Name="Add Emails" Background="{DynamicResource ControlFillColorDefaultBrush}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" /></StackPanel>
 <ItemsControl x:Name="icEmails" Margin="0,12,0,0" ItemsSource="{Binding lstValues}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:MultiValueFieldViewModel+EntryViewModel"><Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4" Padding="12,8" Margin="0,0,0,4"><Grid ColumnDefinitions="*,Auto" ColumnSpacing="8"><TextBlock Grid.Column="0" Text="{Binding strValue}" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" /><Button x:Name="btnRemoveEmail" Grid.Column="1" Content="X" Command="{Binding cmdRemove}" VerticalAlignment="Center" MinWidth="32" MinHeight="32" Padding="8,4" CornerRadius="4" BorderThickness="0" Background="{DynamicResource ControlFillColorSecondaryBrush}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" AutomationProperties.Name="{Binding strValue, StringFormat='Remove {0}'}" /></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
 <TextBlock Text="{Binding strError}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
</StackPanel></StackPanel>
<StackPanel IsEnabled="{Binding vmWorkspace.bCanEditOrganization}"><StackPanel Spacing="6" MaxWidth="480" HorizontalAlignment="Left" DataContext="{Binding vmPhones}" x:DataType="vm:MultiValueFieldViewModel">
 <TextBlock Text="Phones" />
 <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Spacing="8"><TextBox x:Name="txtNewPhone" Width="300" Text="{Binding strNewValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Watermark="Add one entry" AutomationProperties.Name="New Phones" Background="{DynamicResource TextControlBackground}" Foreground="{DynamicResource TextControlForeground}" /><Button x:Name="btnAddPhone" Content="Add" Command="{Binding cmdAdd}" AutomationProperties.Name="Add Phones" Background="{DynamicResource ControlFillColorDefaultBrush}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" /></StackPanel>
 <ItemsControl x:Name="icPhones" Margin="0,12,0,0" ItemsSource="{Binding lstValues}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:MultiValueFieldViewModel+EntryViewModel"><Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4" Padding="12,8" Margin="0,0,0,4"><Grid ColumnDefinitions="*,Auto" ColumnSpacing="8"><TextBlock Grid.Column="0" Text="{Binding strValue}" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" /><Button x:Name="btnRemovePhone" Grid.Column="1" Content="X" Command="{Binding cmdRemove}" VerticalAlignment="Center" MinWidth="32" MinHeight="32" Padding="8,4" CornerRadius="4" BorderThickness="0" Background="{DynamicResource ControlFillColorSecondaryBrush}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" AutomationProperties.Name="{Binding strValue, StringFormat='Remove {0}'}" /></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
 <TextBlock Text="{Binding strError}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
</StackPanel></StackPanel>
<StackPanel IsEnabled="{Binding vmWorkspace.bCanEditOrganization}"><StackPanel Spacing="6" MaxWidth="480" HorizontalAlignment="Left" DataContext="{Binding vmAddresses}" x:DataType="vm:MultiValueFieldViewModel">
 <TextBlock Text="Addresses" />
 <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Spacing="8"><TextBox x:Name="txtNewAddress" Width="300" Text="{Binding strNewValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Watermark="Add one entry" AutomationProperties.Name="New Addresses" Background="{DynamicResource TextControlBackground}" Foreground="{DynamicResource TextControlForeground}" /><Button x:Name="btnAddAddress" Content="Add" Command="{Binding cmdAdd}" AutomationProperties.Name="Add Addresses" Background="{DynamicResource ControlFillColorDefaultBrush}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" /></StackPanel>
 <ItemsControl x:Name="icAddresses" Margin="0,12,0,0" ItemsSource="{Binding lstValues}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:MultiValueFieldViewModel+EntryViewModel"><Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4" Padding="12,8" Margin="0,0,0,4"><Grid ColumnDefinitions="*,Auto" ColumnSpacing="8"><TextBlock Grid.Column="0" Text="{Binding strValue}" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" /><Button x:Name="btnRemoveAddress" Grid.Column="1" Content="X" Command="{Binding cmdRemove}" VerticalAlignment="Center" MinWidth="32" MinHeight="32" Padding="8,4" CornerRadius="4" BorderThickness="0" Background="{DynamicResource ControlFillColorSecondaryBrush}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" AutomationProperties.Name="{Binding strValue, StringFormat='Remove {0}'}" /></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
 <TextBlock Text="{Binding strError}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
</StackPanel></StackPanel>
<StackPanel Spacing="6"><TextBlock Text="Skills / Services" /><views:TokenChipsView x:Name="ctrOrganizationSkills" lstValues="{Binding vmWorkspace.lstOrganizationSkills}" /><Button x:Name="btnManageOrganizationSkills" Content="Manage Skills" Click="OnManageSkills" IsEnabled="{Binding vmWorkspace.bCanEditOrganization}" /></StackPanel>
<StackPanel Spacing="6"><TextBlock Text="Tags" /><views:TokenChipsView x:Name="ctrOrganizationTags" lstValues="{Binding vmWorkspace.lstOrganizationTags}" /><Button x:Name="btnManageOrganizationTags" Content="Manage Tags" Click="OnManageTags" IsEnabled="{Binding vmWorkspace.bCanEditOrganization}" /></StackPanel>
    <StackPanel Spacing="6"><TextBlock Text="Status" Classes="fieldLabel" /><ComboBox x:Name="cboEditOrganizationStatus" SelectedItem="{Binding vmWorkspace.objOrganization.Status, Mode=TwoWay}" IsEnabled="{Binding vmWorkspace.bCanEditOrganization}" AutomationProperties.Name="Organization status">
     <ComboBox.Items><x:Static Member="core:RecordStatus.Active" /><x:Static Member="core:RecordStatus.Inactive" /><x:Static Member="core:RecordStatus.Retired" /><x:Static Member="core:RecordStatus.Deceased" /></ComboBox.Items>
    </ComboBox></StackPanel>
    <StackPanel Orientation="Horizontal" Spacing="12"><Button x:Name="btnSaveOrganizationProfile" Content="Save" Classes="primary" Command="{Binding cmdSave}" IsEnabled="{Binding vmWorkspace.bCanEditOrganization}" /><Button x:Name="btnCancelOrganizationProfile" Content="Cancel" Command="{Binding cmdCancel}" /></StackPanel>
    <Button x:Name="btnArchiveOrganizationProfile" Content="Archive / Restore organization" Command="{Binding cmdArchive}" IsEnabled="{Binding vmWorkspace.bCanEditOrganization}" />
   </StackPanel>
  </ScrollViewer></UserControl>