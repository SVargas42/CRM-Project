<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HippoCrm.Desktop.ViewModels" xmlns:views="using:HippoCrm.Desktop.Views"
             x:Class="HippoCrm.Desktop.Views.OrganizationsRootView" x:DataType="vm:OrganizationsPageViewModel">
  <Grid x:Name="grdOrganizationsRoot">
    <TabControl x:Name="tcOrganizations" Classes="WorkspaceSubTabs" SelectedIndex="{Binding iSelectedTab, Mode=TwoWay}" IsVisible="{Binding !bProfile}">
      <TabItem x:Name="tiOrgLookup" Header="Lookup">
        <Grid RowDefinitions="Auto,*" RowSpacing="12" Margin="0,12,0,0">
          <WrapPanel x:Name="pnlOrganizationFilters">
            <StackPanel Spacing="6" Margin="0,0,12,8">
              <TextBlock Text="Name, service, email, phone, or tag" />
              <TextBox x:Name="txtOrganizationLookupSearch" Width="260"
                       Text="{Binding strSearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Search organizations" />
            </StackPanel>
            <StackPanel Spacing="6" Margin="0,0,12,8">
              <TextBlock Text="Status" />
              <ComboBox x:Name="cboOrganizationStatusFilter" SelectedIndex="{Binding iStatusFilter, Mode=TwoWay}" AutomationProperties.Name="Organization status filter">
                <ComboBoxItem Content="Any status" /><ComboBoxItem Content="Active" /><ComboBoxItem Content="Inactive" />
                <ComboBoxItem Content="Retired" /><ComboBoxItem Content="Deceased" />
              </ComboBox>
            </StackPanel>
            <CheckBox x:Name="chkOrganizationsArchived" Content="Archived records" IsChecked="{Binding vmWorkspace.bArchived, Mode=TwoWay}" Margin="0,20,12,8" />
            <Button x:Name="btnApplyOrganizationFilters" Content="Apply filters" Command="{Binding vmWorkspace.cmdApplyFilters}" Margin="0,20,0,8" />
          </WrapPanel>
          <ListBox x:Name="lstOrganizationLookup" Grid.Row="1" ItemsSource="{Binding lstRows}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                   Background="Transparent" BorderThickness="0" AutomationProperties.Name="Organization lookup results">
            <ListBox.Styles><Style Selector="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /></Style></ListBox.Styles>
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:OrganizationLookupRowViewModel">
                <Border x:Name="bdrOrganizationLookupResult" BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" CornerRadius="12" Margin="0,0,0,10" Padding="16">
                 <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="16" RowSpacing="12">
                  <TextBlock Text="{Binding strName}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" />
                  <Button x:Name="btnViewOrgProfile" Grid.Column="1" Content="View Profile" Classes="primary" Command="{Binding cmdViewProfile}"
                          AutomationProperties.Name="{Binding strName, StringFormat='View profile for {0}'}" />
                  <Grid Grid.Row="1" Grid.ColumnSpan="2" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="20" RowSpacing="10">
                   <StackPanel Spacing="3"><TextBlock Text="Status" Classes="fieldLabel" /><TextBlock Text="{Binding strStatus}" TextWrapping="Wrap" /></StackPanel>
                   <StackPanel Grid.Column="1" Spacing="3"><TextBlock Text="Phone" Classes="fieldLabel" /><TextBlock Text="{Binding strPhone}" TextWrapping="Wrap" /></StackPanel>
                   <StackPanel Grid.Row="1" Spacing="3"><TextBlock Text="Email" Classes="fieldLabel" /><TextBlock Text="{Binding strEmail}" TextWrapping="Wrap" /></StackPanel>
                   <StackPanel Grid.Row="1" Grid.Column="1" Spacing="3"><TextBlock Text="Services" Classes="fieldLabel" /><views:TokenChipsView x:Name="ctrOrganizationLookupSkills" lstValues="{Binding lstSkills}" VerticalAlignment="Center" /></StackPanel>
                  </Grid>
                 </Grid>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </TabItem>
      <TabItem x:Name="tiOrgAdd" Header="Add Organization" IsEnabled="{Binding vmWorkspace.bCanCreate}">
        <views:OrganizationEditorView x:Name="vAddOrganization" DataContext="{Binding vmWorkspace}" Margin="0,12,0,0" />
      </TabItem>
    </TabControl>
    <ContentControl x:Name="ctrOrganizationProfile" Content="{Binding vmProfile}" IsVisible="{Binding bProfile}"
                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
      <ContentControl.ContentTemplate><DataTemplate x:DataType="vm:OrganizationProfileViewModel"><views:OrganizationProfileView x:Name="vOrganizationProfile" /></DataTemplate></ContentControl.ContentTemplate>
    </ContentControl>
  </Grid>
</UserControl>
