<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HippoCrm.Desktop.ViewModels" xmlns:controls="using:HippoCrm.Desktop" xmlns:core="using:HippoCrm.Core" xmlns:views="using:HippoCrm.Desktop.Views"
             x:Class="HippoCrm.Desktop.Views.OrganizationEditorView" x:DataType="vm:MainWindowViewModel">
  <ScrollViewer x:Name="scrOrganizationEditor" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Center">
    <StackPanel x:Name="pnlOrganizationEditor" Spacing="16" Margin="0,0,12,0" MaxWidth="1080" HorizontalAlignment="Stretch">
      <views:ProfilePicturePanel bContact="False" />
      <Button x:Name="btnArchiveOrganization" Content="Archive / Restore organization" Command="{Binding cmdArchiveOrganization}"
              IsVisible="{Binding bSavedOrganization}" IsEnabled="{Binding bCanEditOrganization}" />
      <StackPanel Spacing="6" HorizontalAlignment="Left"><TextBlock Text="Organization name *" /><controls:CrmTextBox x:Name="txtOrganizationName" Width="680" HorizontalAlignment="Left" Classes="fieldWide" Tag="Organization name *" Text="{Binding objOrganization.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                  IsReadOnly="{Binding !bCanEditOrganization}" AutomationProperties.Name="Organization name *" /></StackPanel>
<StackPanel IsEnabled="{Binding bCanEditOrganization}" HorizontalAlignment="Left"><StackPanel Spacing="6" HorizontalAlignment="Left" DataContext="{Binding vmNewOrganizationEmails}" x:DataType="vm:MultiValueFieldViewModel">
 <TextBlock Text="Emails" />
 <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="8" HorizontalAlignment="Left"><controls:CrmTextBox x:Name="txtNewOrganizationEmail" Width="420" Classes="fieldStandard" Text="{Binding strNewValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Watermark="Add one entry" AutomationProperties.Name="New Emails" Background="{DynamicResource TextControlBackground}" Foreground="{DynamicResource TextControlForeground}" HorizontalAlignment="Left" /><Button Grid.Column="1" x:Name="btnAddOrganizationEmail" Content="Add" Command="{Binding cmdAdd}" AutomationProperties.Name="Add Emails" Classes="inlineAction" /></Grid>
 <ItemsControl x:Name="icNewOrganizationEmails" Margin="0,12,0,0" ItemsSource="{Binding lstValues}" IsVisible="{Binding bHasValues}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:MultiValueFieldViewModel+EntryViewModel"><Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,4"><Grid ColumnDefinitions="*,Auto" ColumnSpacing="8"><TextBlock Grid.Column="0" Text="{Binding strValue}" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" /><Button x:Name="btnRemoveOrganizationEmail" Grid.Column="1" Content="×" Command="{Binding cmdRemove}" VerticalAlignment="Center" Width="30" MinWidth="30" Height="30" MinHeight="30" Padding="11,4" CornerRadius="6" BorderThickness="0" Background="{DynamicResource ControlFillColorSecondaryBrush}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" AutomationProperties.Name="{Binding strValue, StringFormat='Remove {0}'}" /></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
 <TextBlock Text="{Binding strError}" IsVisible="{Binding bHasError}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
</StackPanel></StackPanel>
<StackPanel IsEnabled="{Binding bCanEditOrganization}" HorizontalAlignment="Left"><StackPanel Spacing="6" HorizontalAlignment="Left" DataContext="{Binding vmNewOrganizationPhones}" x:DataType="vm:MultiValueFieldViewModel">
 <TextBlock Text="Phones" />
 <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="8" HorizontalAlignment="Left"><controls:CrmTextBox x:Name="txtNewOrganizationPhone" Width="220" Classes="fieldCompact" Text="{Binding strNewValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Watermark="Add one entry" AutomationProperties.Name="New Phones" Background="{DynamicResource TextControlBackground}" Foreground="{DynamicResource TextControlForeground}" HorizontalAlignment="Left" /><Button Grid.Column="1" x:Name="btnAddOrganizationPhone" Content="Add" Command="{Binding cmdAdd}" AutomationProperties.Name="Add Phones" Classes="inlineAction" /></Grid>
 <ItemsControl x:Name="icNewOrganizationPhones" Margin="0,12,0,0" ItemsSource="{Binding lstValues}" IsVisible="{Binding bHasValues}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:MultiValueFieldViewModel+EntryViewModel"><Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,4"><Grid ColumnDefinitions="*,Auto" ColumnSpacing="8"><TextBlock Grid.Column="0" Text="{Binding strValue}" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" /><Button x:Name="btnRemoveOrganizationPhone" Grid.Column="1" Content="×" Command="{Binding cmdRemove}" VerticalAlignment="Center" Width="30" MinWidth="30" Height="30" MinHeight="30" Padding="11,4" CornerRadius="6" BorderThickness="0" Background="{DynamicResource ControlFillColorSecondaryBrush}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" AutomationProperties.Name="{Binding strValue, StringFormat='Remove {0}'}" /></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
 <TextBlock Text="{Binding strError}" IsVisible="{Binding bHasError}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
</StackPanel></StackPanel>
<StackPanel IsEnabled="{Binding bCanEditOrganization}" HorizontalAlignment="Left"><StackPanel Spacing="6" HorizontalAlignment="Left" DataContext="{Binding vmNewOrganizationAddresses}" x:DataType="vm:MultiValueFieldViewModel">
 <TextBlock Text="Addresses" />
 <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="8" HorizontalAlignment="Left"><controls:CrmTextBox x:Name="txtNewOrganizationAddress" Width="420" Classes="fieldWide" Text="{Binding strNewValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Watermark="Add one entry" AutomationProperties.Name="New Addresses" Background="{DynamicResource TextControlBackground}" Foreground="{DynamicResource TextControlForeground}" HorizontalAlignment="Left" /><Button Grid.Column="1" x:Name="btnAddOrganizationAddress" Content="Add" Command="{Binding cmdAdd}" AutomationProperties.Name="Add Addresses" Classes="inlineAction" /></Grid>
 <ItemsControl x:Name="icNewOrganizationAddresses" Margin="0,12,0,0" ItemsSource="{Binding lstValues}" IsVisible="{Binding bHasValues}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:MultiValueFieldViewModel+EntryViewModel"><Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,4"><Grid ColumnDefinitions="*,Auto" ColumnSpacing="8"><TextBlock Grid.Column="0" Text="{Binding strValue}" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" /><Button x:Name="btnRemoveOrganizationAddress" Grid.Column="1" Content="×" Command="{Binding cmdRemove}" VerticalAlignment="Center" Width="30" MinWidth="30" Height="30" MinHeight="30" Padding="11,4" CornerRadius="6" BorderThickness="0" Background="{DynamicResource ControlFillColorSecondaryBrush}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" AutomationProperties.Name="{Binding strValue, StringFormat='Remove {0}'}" /></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
 <TextBlock Text="{Binding strError}" IsVisible="{Binding bHasError}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
</StackPanel></StackPanel>
<StackPanel Spacing="6"><TextBlock Text="Services" /><views:TokenChipsView x:Name="ctrOrganizationServices" lstValues="{Binding lstOrganizationServices}" /><Button Classes="inlineAction" x:Name="btnManageOrganizationServices" Content="Manage Services" Click="OnManageServices" IsEnabled="{Binding bCanEditOrganization}" /></StackPanel>
<StackPanel Spacing="6"><TextBlock Text="Tags" /><views:TokenChipsView x:Name="ctrOrganizationTags" lstValues="{Binding lstOrganizationTags}" /><Button Classes="inlineAction" x:Name="btnManageOrganizationTags" Content="Manage Tags" Click="OnManageTags" IsEnabled="{Binding bCanEditOrganization}" /></StackPanel>
      <Button x:Name="btnSaveOrganization" Content="Save Organization" Classes="primary" Command="{Binding cmdSaveOrganization}" IsEnabled="{Binding bCanEditOrganization}" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
