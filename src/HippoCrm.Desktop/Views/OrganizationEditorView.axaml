<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HippoCrm.Desktop.ViewModels" xmlns:core="using:HippoCrm.Core" xmlns:views="using:HippoCrm.Desktop.Views"
             x:Class="HippoCrm.Desktop.Views.OrganizationEditorView" x:DataType="vm:MainWindowViewModel">
  <ScrollViewer x:Name="scrOrganizationEditor" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel x:Name="pnlOrganizationEditor" Spacing="12">
      <Button x:Name="btnArchiveOrganization" Content="Archive / Restore organization" Command="{Binding cmdArchiveOrganization}"
              IsVisible="{Binding bSavedOrganization}" IsEnabled="{Binding bCanEditOrganization}" />
      <StackPanel Spacing="6"><TextBlock Text="Organization name *" /><TextBox x:Name="txtOrganizationName" Tag="Organization name *" Text="{Binding objOrganization.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                  IsReadOnly="{Binding !bCanEditOrganization}" AutomationProperties.Name="Organization name *" /></StackPanel>
<StackPanel IsEnabled="{Binding bCanEditOrganization}"><StackPanel Spacing="6" MaxWidth="480" HorizontalAlignment="Left" DataContext="{Binding vmNewOrganizationEmails}" x:DataType="vm:MultiValueFieldViewModel">
 <TextBlock Text="Emails" />
 <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Spacing="8"><TextBox x:Name="txtNewOrganizationEmail" Width="300" Text="{Binding strNewValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Watermark="Add one entry" AutomationProperties.Name="New Emails" Background="{DynamicResource TextControlBackground}" Foreground="{DynamicResource TextControlForeground}" /><Button x:Name="btnAddOrganizationEmail" Content="Add" Command="{Binding cmdAdd}" AutomationProperties.Name="Add Emails" Background="{DynamicResource ControlFillColorDefaultBrush}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" /></StackPanel>
 <ItemsControl x:Name="icNewOrganizationEmails" Margin="0,12,0,0" ItemsSource="{Binding lstValues}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:MultiValueFieldViewModel+EntryViewModel"><Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4" Padding="12,8" Margin="0,0,0,4"><Grid ColumnDefinitions="*,Auto" ColumnSpacing="8"><TextBlock Grid.Column="0" Text="{Binding strValue}" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" /><Button x:Name="btnRemoveOrganizationEmail" Grid.Column="1" Content="X" Command="{Binding cmdRemove}" VerticalAlignment="Center" MinWidth="32" MinHeight="32" Padding="8,4" CornerRadius="4" BorderThickness="0" Background="{DynamicResource ControlFillColorSecondaryBrush}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" AutomationProperties.Name="{Binding strValue, StringFormat='Remove {0}'}" /></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
 <TextBlock Text="{Binding strError}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
</StackPanel></StackPanel>
<StackPanel IsEnabled="{Binding bCanEditOrganization}"><StackPanel Spacing="6" MaxWidth="480" HorizontalAlignment="Left" DataContext="{Binding vmNewOrganizationPhones}" x:DataType="vm:MultiValueFieldViewModel">
 <TextBlock Text="Phones" />
 <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Spacing="8"><TextBox x:Name="txtNewOrganizationPhone" Width="300" Text="{Binding strNewValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Watermark="Add one entry" AutomationProperties.Name="New Phones" Background="{DynamicResource TextControlBackground}" Foreground="{DynamicResource TextControlForeground}" /><Button x:Name="btnAddOrganizationPhone" Content="Add" Command="{Binding cmdAdd}" AutomationProperties.Name="Add Phones" Background="{DynamicResource ControlFillColorDefaultBrush}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" /></StackPanel>
 <ItemsControl x:Name="icNewOrganizationPhones" Margin="0,12,0,0" ItemsSource="{Binding lstValues}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:MultiValueFieldViewModel+EntryViewModel"><Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4" Padding="12,8" Margin="0,0,0,4"><Grid ColumnDefinitions="*,Auto" ColumnSpacing="8"><TextBlock Grid.Column="0" Text="{Binding strValue}" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" /><Button x:Name="btnRemoveOrganizationPhone" Grid.Column="1" Content="X" Command="{Binding cmdRemove}" VerticalAlignment="Center" MinWidth="32" MinHeight="32" Padding="8,4" CornerRadius="4" BorderThickness="0" Background="{DynamicResource ControlFillColorSecondaryBrush}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" AutomationProperties.Name="{Binding strValue, StringFormat='Remove {0}'}" /></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
 <TextBlock Text="{Binding strError}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
</StackPanel></StackPanel>
<StackPanel IsEnabled="{Binding bCanEditOrganization}"><StackPanel Spacing="6" MaxWidth="480" HorizontalAlignment="Left" DataContext="{Binding vmNewOrganizationAddresses}" x:DataType="vm:MultiValueFieldViewModel">
 <TextBlock Text="Addresses" />
 <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Spacing="8"><TextBox x:Name="txtNewOrganizationAddress" Width="300" Text="{Binding strNewValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Watermark="Add one entry" AutomationProperties.Name="New Addresses" Background="{DynamicResource TextControlBackground}" Foreground="{DynamicResource TextControlForeground}" /><Button x:Name="btnAddOrganizationAddress" Content="Add" Command="{Binding cmdAdd}" AutomationProperties.Name="Add Addresses" Background="{DynamicResource ControlFillColorDefaultBrush}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" /></StackPanel>
 <ItemsControl x:Name="icNewOrganizationAddresses" Margin="0,12,0,0" ItemsSource="{Binding lstValues}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:MultiValueFieldViewModel+EntryViewModel"><Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4" Padding="12,8" Margin="0,0,0,4"><Grid ColumnDefinitions="*,Auto" ColumnSpacing="8"><TextBlock Grid.Column="0" Text="{Binding strValue}" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" /><Button x:Name="btnRemoveOrganizationAddress" Grid.Column="1" Content="X" Command="{Binding cmdRemove}" VerticalAlignment="Center" MinWidth="32" MinHeight="32" Padding="8,4" CornerRadius="4" BorderThickness="0" Background="{DynamicResource ControlFillColorSecondaryBrush}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" AutomationProperties.Name="{Binding strValue, StringFormat='Remove {0}'}" /></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
 <TextBlock Text="{Binding strError}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
</StackPanel></StackPanel>
<StackPanel Spacing="6"><TextBlock Text="Skills / Services" /><views:TokenChipsView x:Name="ctrOrganizationSkills" lstValues="{Binding lstOrganizationSkills}" /><Button x:Name="btnManageOrganizationSkills" Content="Manage Skills" Click="OnManageSkills" IsEnabled="{Binding bCanEditOrganization}" /></StackPanel>
<StackPanel Spacing="6"><TextBlock Text="Tags" /><views:TokenChipsView x:Name="ctrOrganizationTags" lstValues="{Binding lstOrganizationTags}" /><Button x:Name="btnManageOrganizationTags" Content="Manage Tags" Click="OnManageTags" IsEnabled="{Binding bCanEditOrganization}" /></StackPanel>
      <StackPanel Spacing="6">
        <TextBlock Text="Status" />
        <ComboBox x:Name="cboOrganizationStatus" SelectedItem="{Binding objOrganization.Status, Mode=TwoWay}" IsEnabled="{Binding bCanEditOrganization}" AutomationProperties.Name="Organization status">
          <ComboBox.Items><x:Static Member="core:RecordStatus.Active" /><x:Static Member="core:RecordStatus.Inactive" /><x:Static Member="core:RecordStatus.Retired" /><x:Static Member="core:RecordStatus.Deceased" /></ComboBox.Items>
        </ComboBox>
      </StackPanel>
      <Button x:Name="btnSaveOrganization" Content="Save Organization" Classes="primary" Command="{Binding cmdSaveOrganization}" IsEnabled="{Binding bCanEditOrganization}" />
    </StackPanel>
  </ScrollViewer>
</UserControl>

