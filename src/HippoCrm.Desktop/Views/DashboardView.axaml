<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HippoCrm.Desktop.ViewModels" xmlns:controls="using:HippoCrm.Desktop" xmlns:views="using:HippoCrm.Desktop.Views"
             x:Class="HippoCrm.Desktop.Views.DashboardView" x:DataType="vm:DashboardViewModel">
  <UserControl.DataTemplates>
    <DataTemplate DataType="{x:Type vm:MasterSearchFilterOption}" x:DataType="vm:MasterSearchFilterOption"><TextBlock Text="{Binding strLabel}" /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:OrganizationOptionViewModel}" x:DataType="vm:OrganizationOptionViewModel"><TextBlock Text="{Binding strName}" /></DataTemplate>
  </UserControl.DataTemplates>
  <UserControl.Styles>
    <Style Selector="Border.dashboardPlaceholder">
      <Setter Property="Padding" Value="28" />
      <Setter Property="Margin" Value="0,12,0,0" />
      <Setter Property="MinHeight" Value="220" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
    </Style>
    <Style Selector="Border.metric">
      <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundAltHighBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="18" />
    </Style>
    <Style Selector="TextBlock.eyebrow">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="LetterSpacing" Value="1" />
    </Style>
    <Style Selector="TextBlock.metricValue">
      <Setter Property="FontSize" Value="30" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.metricLabel">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
  </UserControl.Styles>
  <TabControl x:Name="tcDashboard" Classes="WorkspaceSubTabs" SelectedIndex="{Binding iSelectedTab, Mode=TwoWay}">
    <TabItem x:Name="tiOverview" Header="Overview">
      <ScrollViewer x:Name="scrDashboard" HorizontalScrollBarVisibility="Auto">
        <StackPanel Spacing="16" Width="{Binding $parent[ScrollViewer].Viewport.Width}">
          <Grid x:Name="gridMetrics" ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="12">
            <Border Classes="metric"><StackPanel Spacing="8"><TextBlock Text="Contacts" Classes="metricLabel" /><TextBlock Text="{Binding iContacts}" Classes="metricValue" /></StackPanel></Border>
            <Border Grid.Column="1" Classes="metric"><StackPanel Spacing="8"><TextBlock Text="Organizations" Classes="metricLabel" /><TextBlock Text="{Binding iOrganizations}" Classes="metricValue" /></StackPanel></Border>
            <Border Grid.Column="2" Classes="metric"><StackPanel Spacing="8"><TextBlock Text="Available" Classes="metricLabel" /><TextBlock Text="{Binding iAvailable}" Classes="metricValue" /></StackPanel></Border>
            <Border Grid.Row="1" Classes="metric"><StackPanel Spacing="8"><TextBlock Text="Archived" Classes="metricLabel" /><TextBlock Text="{Binding iArchived}" Classes="metricValue" /></StackPanel></Border>
            <Border Grid.Row="1" Grid.Column="1" Classes="metric"><StackPanel Spacing="8"><TextBlock Text="Interactions · 30 days" Classes="metricLabel" /><TextBlock Text="{Binding iInteractions}" Classes="metricValue" /></StackPanel></Border>
            <Border Grid.Row="1" Grid.Column="2" Classes="metric"><StackPanel Spacing="8"><TextBlock Text="Follow-ups due" Classes="metricLabel" /><TextBlock Text="{Binding iOverdue}" Classes="metricValue" /></StackPanel></Border>
          </Grid>

          <Grid RowDefinitions="Auto,Auto" RowSpacing="12">
            <Border Classes="metric">
              <Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="12">
                <TextBlock Text="Weekly interaction activity" FontSize="18" FontWeight="SemiBold" />
                <Grid Grid.Row="1" ColumnDefinitions="*,90,2*" ColumnSpacing="16">
                  <TextBlock Text="PERIOD" Classes="eyebrow" /><TextBlock Grid.Column="1" Text="EVENTS" Classes="eyebrow" HorizontalAlignment="Right" /><TextBlock Grid.Column="2" Text="RELATIVE VOLUME" Classes="eyebrow" />
                </Grid>
                <ItemsControl x:Name="lstWeeklyActivity" Grid.Row="2" ItemsSource="{Binding lstActivity}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ActivityRowViewModel">
                      <Border Padding="0,12" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
                        <Grid ColumnDefinitions="*,90,2*" ColumnSpacing="16">
                          <TextBlock Text="{Binding strPeriod}" VerticalAlignment="Center" />
                          <TextBlock Grid.Column="1" Text="{Binding iInteractions}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                          <ProgressBar Grid.Column="2" Value="{Binding iPercent}" Maximum="100" Height="8" VerticalAlignment="Center"
                                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                                       AutomationProperties.Name="Relative weekly interaction volume" />
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Grid.Row="3" IsVisible="{Binding !bHasActivity}" Text="No activity is available for this workspace." TextWrapping="Wrap" />
              </Grid>
            </Border>
            <Border Grid.Row="1" Classes="metric">
              <Grid ColumnDefinitions="*,*,*" ColumnSpacing="24">
               <StackPanel Spacing="10">
                <TextBlock Text="Workspace overview" FontSize="18" FontWeight="SemiBold" />
                <TextBlock Text="Review overdue relationships, confirm availability, and record interactions in the relevant profile." TextWrapping="Wrap" />
               </StackPanel>
               <StackPanel Grid.Column="1" Spacing="10">
                <TextBlock Text="ACCESS CONTROL" Classes="eyebrow" />
                <TextBlock Text="Totals reflect the records authorized for the signed-in account." TextWrapping="Wrap" />
               </StackPanel>
               <StackPanel Grid.Column="2" Spacing="10">
                <TextBlock Text="LOCAL OPERATION" Classes="eyebrow" />
                <TextBlock Text="Encrypted local workspace. No cloud synchronization." TextWrapping="Wrap" />
               </StackPanel>
              </Grid>
            </Border>
          </Grid>
        </StackPanel>
      </ScrollViewer>
    </TabItem>
    <TabItem x:Name="tiAnalytics" Header="Analytics">
      <Grid RowDefinitions="Auto,*" RowSpacing="12" Margin="0,12,0,0">
        <StackPanel DataContext="{Binding vmAnalytics}" x:DataType="vm:AnalyticsViewModel" Spacing="8">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="{Binding strLoadedAt}" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" />
            <Button Grid.Column="1" Content="Refresh" Command="{Binding cmdRefresh}" AutomationProperties.Name="Refresh analytics" />
          </Grid>
          <TextBlock Text="All times are UTC. Counts and filters apply to the loaded snapshot." TextWrapping="Wrap" />
          <ProgressBar IsIndeterminate="True" IsVisible="{Binding bLoading}" Height="4" AutomationProperties.Name="Loading analytics" />
          <StackPanel IsVisible="{Binding bFailed}" Orientation="Horizontal" Spacing="12">
            <TextBlock Text="{Binding strError}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
            <Button Content="Reload" Command="{Binding cmdRefresh}" AutomationProperties.Name="Reload analytics" />
          </StackPanel>
        </StackPanel>
      <TabControl Grid.Row="1" x:Name="tcAnalyticsSub" Classes="WorkspaceSubTabs" SelectedIndex="{Binding iSelectedAnalyticsTab, Mode=TwoWay}">
        <TabItem x:Name="tiCombinedAnalytics" Header="Combined Analytics">
          <ScrollViewer HorizontalScrollBarVisibility="Auto"><StackPanel DataContext="{Binding vmAnalytics}" x:DataType="vm:AnalyticsViewModel" Spacing="16" Margin="8">
            <CheckBox x:Name="chkAnalyticsInclude" Content="Include inactive and archived records" IsChecked="{Binding bIncludeInactive, Mode=TwoWay}" AutomationProperties.Name="Include inactive and archived records" />
            <WrapPanel>
              <Border Classes="metric" Margin="4"><StackPanel><TextBlock Text="Active contacts" /><TextBlock x:Name="txtAnalyticsActiveContacts" Text="{Binding strActiveContacts, FallbackValue='', TargetNullValue=''}" /></StackPanel></Border>
              <Border Classes="metric" Margin="4"><StackPanel><TextBlock Text="Inactive contacts" /><TextBlock x:Name="txtAnalyticsInactiveContacts" Text="{Binding strInactiveContacts, FallbackValue='', TargetNullValue=''}" /></StackPanel></Border>
              <Border Classes="metric" Margin="4"><StackPanel><TextBlock Text="Retired contacts" /><TextBlock x:Name="txtAnalyticsRetiredContacts" Text="{Binding strRetiredContacts, FallbackValue='', TargetNullValue=''}" /></StackPanel></Border>
              <Border Classes="metric" Margin="4"><StackPanel><TextBlock Text="Deceased contacts" /><TextBlock x:Name="txtAnalyticsDeceasedContacts" Text="{Binding strDeceasedContacts, FallbackValue='', TargetNullValue=''}" /></StackPanel></Border>
              <Border Classes="metric" Margin="4"><StackPanel><TextBlock Text="Active organizations" /><TextBlock x:Name="txtAnalyticsActiveOrganizations" Text="{Binding strActiveOrganizations, FallbackValue='', TargetNullValue=''}" /></StackPanel></Border>
              <Border Classes="metric" Margin="4"><StackPanel><TextBlock Text="Archived organizations" /><TextBlock x:Name="txtAnalyticsArchivedOrganizations" Text="{Binding strArchivedOrganizations, FallbackValue='', TargetNullValue=''}" /></StackPanel></Border>
            </WrapPanel>
            <StackPanel Spacing="6"><TextBlock Text="Period" /><ComboBox x:Name="cmbAnalyticsPeriod" ItemsSource="{Binding lstPeriods}" SelectedIndex="{Binding iPeriod, Mode=TwoWay}" AutomationProperties.Name="Analytics period" /></StackPanel>
            <views:AnalyticsTableView x:Name="tblAnalyticsDetail" DataContext="{Binding vmPeriodDetail}" />
            <views:AnalyticsTableView x:Name="tblAnalyticsPeriods" DataContext="{Binding vmPeriods}" />
            <TextBlock Text="Contact status checkboxes on the Contact tab also filter the contract, member and movement lists." TextWrapping="Wrap" />
            <views:AnalyticsTableView x:Name="tblAnalyticsContracts" DataContext="{Binding vmContracts}" />
          </StackPanel></ScrollViewer>
        </TabItem>
        <TabItem x:Name="tiContactAnalytics" Header="Contact Analytics">
          <ScrollViewer HorizontalScrollBarVisibility="Auto"><StackPanel DataContext="{Binding vmAnalytics}" x:DataType="vm:AnalyticsViewModel" Spacing="16" Margin="8">
            <TextBlock Text="Contact status (applies to every contact list)" />
            <WrapPanel>
              <CheckBox x:Name="chkAnalyticsActive" Content="Active" IsChecked="{Binding bActive, Mode=TwoWay}" AutomationProperties.Name="Include Active contacts in analytics lists" Margin="0,0,16,0" />
              <CheckBox x:Name="chkAnalyticsInactive" Content="Inactive" IsChecked="{Binding bInactive, Mode=TwoWay}" AutomationProperties.Name="Include Inactive contacts in analytics lists" Margin="0,0,16,0" />
              <CheckBox x:Name="chkAnalyticsRetired" Content="Retired" IsChecked="{Binding bRetired, Mode=TwoWay}" AutomationProperties.Name="Include Retired contacts in analytics lists" Margin="0,0,16,0" />
              <CheckBox x:Name="chkAnalyticsDeceased" Content="Deceased" IsChecked="{Binding bDeceased, Mode=TwoWay}" AutomationProperties.Name="Include Deceased contacts in analytics lists" />
            </WrapPanel>
            <StackPanel Spacing="6"><TextBlock Text="Not contacted in at least N days" />
              <controls:CrmTextBox x:Name="txtAnalyticsDays" Text="{Binding strDays, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, FallbackValue='', TargetNullValue=''}" MaxLength="4" Width="160" HorizontalAlignment="Left" AutomationProperties.Name="Not contacted in at least N days, 1 to 3650" />
              <TextBlock Text="{Binding strDaysError}" IsVisible="{Binding bDaysError}" AutomationProperties.LiveSetting="Polite" />
            </StackPanel>
            <views:AnalyticsTableView x:Name="tblAnalyticsLast" DataContext="{Binding vmLastContacted}" />
            <StackPanel Spacing="6"><TextBlock Text="Search skills" />
              <controls:CrmTextBox x:Name="txtAnalyticsSkill" Text="{Binding strSkillSearch, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, FallbackValue='', TargetNullValue=''}" MaxLength="512" AutomationProperties.Name="Search analytics skills by fragment or similar sounding word" />
            </StackPanel>
            <views:AnalyticsTableView x:Name="tblAnalyticsSkills" DataContext="{Binding vmSkills}" />
            <TextBlock Text="No skills match the selected filters." IsVisible="{Binding bNoSkills}" AutomationProperties.LiveSetting="Polite" />
          </StackPanel></ScrollViewer>
        </TabItem>
        <TabItem x:Name="tiOrganizationAnalytics" Header="Organization Analytics">
          <ScrollViewer HorizontalScrollBarVisibility="Auto"><StackPanel DataContext="{Binding vmAnalytics}" x:DataType="vm:AnalyticsViewModel" Spacing="16" Margin="8">
            <StackPanel Spacing="6"><TextBlock Text="Organization lifecycle" />
              <ComboBox x:Name="cmbAnalyticsOrganizationLifecycle" SelectedIndex="{Binding iOrganizationLifecycle, Mode=TwoWay}" AutomationProperties.Name="Analytics organization Active or Archived choice"><ComboBoxItem Content="Active" /><ComboBoxItem Content="Archived" /></ComboBox>
            </StackPanel>
            <views:AnalyticsTableView x:Name="tblAnalyticsOrganizations" DataContext="{Binding vmOrganizations}" />
            <TextBlock Text="Select an organization" IsVisible="{Binding bSelectOrganization}" AutomationProperties.LiveSetting="Polite" />
            <TextBlock x:Name="txtAnalyticsMemberStatuses" Text="{Binding strShownContactStatuses, FallbackValue='', TargetNullValue=''}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
            <views:AnalyticsTableView x:Name="tblAnalyticsMembers" DataContext="{Binding vmMembers}" />
            <TextBlock Text="No members match the selected contact statuses." IsVisible="{Binding bNoMembers}" AutomationProperties.LiveSetting="Polite" />
            <TextBlock x:Name="txtAnalyticsMovementStatuses" Text="{Binding strShownContactStatuses, FallbackValue='', TargetNullValue=''}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
            <views:AnalyticsTableView x:Name="tblAnalyticsMovement" DataContext="{Binding vmMovement}" />
            <TextBlock Text="No movement history yet. Add placements in a contact's Employment tab." IsVisible="{Binding bNoMovement}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
          </StackPanel></ScrollViewer>
        </TabItem>
      </TabControl>
      </Grid>
    </TabItem>
    <TabItem x:Name="tiMasterSearch" Header="Master Search">
      <Grid x:Name="grdMasterSearch" DataContext="{Binding vmMasterSearch}" x:DataType="vm:MasterSearchViewModel"
            RowDefinitions="Auto,Auto,Auto,Auto,*" RowSpacing="12" Margin="0,12,0,0">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" IsEnabled="{Binding !bSearching}">
          <controls:CrmTextBox x:Name="txtMasterSearch" Classes="fieldSearch" Text="{Binding strSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                   Watermark="Search contacts and organizations" FontSize="18" AutomationProperties.Name="Master search text" />
          <Button x:Name="btnMasterSearch" Grid.Column="1" Content="Search" Classes="primary" Command="{Binding cmdSearch}" />
        </Grid>
        <WrapPanel x:Name="pnlMasterFilters" Grid.Row="1" IsEnabled="{Binding !bSearching}">
          <StackPanel Spacing="6" Margin="0,0,12,8"><TextBlock Text="Tags" /><ComboBox x:Name="cmbFilterTags" Width="180" ItemsSource="{Binding lstTags}" SelectedItem="{Binding objSelectedTag, Mode=TwoWay}" AutomationProperties.Name="Filter by tag" /></StackPanel>
          <StackPanel Spacing="6" Margin="0,0,12,8"><TextBlock Text="Contact status" /><ComboBox x:Name="cmbFilterStatus" Width="150" ItemsSource="{Binding lstStatuses}" SelectedItem="{Binding objSelectedStatus, Mode=TwoWay}" AutomationProperties.Name="Filter contacts by status" /></StackPanel>
          <StackPanel Spacing="6" Margin="0,0,12,8"><TextBlock Text="Organizations" /><ComboBox x:Name="cmbFilterOrganizations" Width="220" ItemsSource="{Binding lstOrganizations}" SelectedItem="{Binding objSelectedOrganization, Mode=TwoWay}" AutomationProperties.Name="Filter by organization" /></StackPanel>
          <StackPanel Spacing="6" Margin="0,0,12,8"><TextBlock Text="Contact skill" /><ComboBox x:Name="cmbFilterSkills" Width="180" ItemsSource="{Binding lstSkills}" SelectedItem="{Binding objSelectedSkill, Mode=TwoWay}" AutomationProperties.Name="Filter contacts by skill" /></StackPanel>
          <StackPanel Spacing="6" Margin="0,0,12,8"><TextBlock Text="Organization service" /><ComboBox x:Name="cmbFilterServices" Width="180" ItemsSource="{Binding lstServices}" SelectedItem="{Binding objSelectedService, Mode=TwoWay}" AutomationProperties.Name="Filter organizations by service" /></StackPanel>
          <StackPanel Spacing="6" Margin="0,0,12,8"><TextBlock Text="Organization lifecycle" /><ComboBox x:Name="cmbOrganizationVisibility" Width="180" SelectedIndex="{Binding iOrganizationVisibility, Mode=TwoWay}" AutomationProperties.Name="Organization Active or Archived filter"><ComboBoxItem Content="Active" /><ComboBoxItem Content="Archived" /></ComboBox></StackPanel>
          <Button x:Name="btnClearMasterFilters" Content="Clear filters" Command="{Binding cmdClearFilters}" Margin="0,24,0,8" />
        </WrapPanel>
        <StackPanel Grid.Row="2" Spacing="6">
          <TextBlock x:Name="txtMasterSearchStatus" Text="{Binding strSearchStatus}" AutomationProperties.LiveSetting="Polite"
                     Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
          <TextBlock Text="{Binding strPageScope}" TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Previous page" Command="{Binding cmdPreviousPage}" AutomationProperties.Name="Previous search page" />
            <Button Content="Next page" Command="{Binding cmdNextPage}" AutomationProperties.Name="Next search page" />
          </StackPanel>
        </StackPanel>
        <Border Grid.Row="3" Padding="8" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
          <Grid ColumnDefinitions="110,2*,3*,110,80" ColumnSpacing="12">
            <TextBlock Text="TYPE" FontWeight="SemiBold" /><TextBlock Grid.Column="1" Text="NAME" FontWeight="SemiBold" />
            <TextBlock Grid.Column="2" Text="PRIMARY INFO" FontWeight="SemiBold" /><TextBlock Grid.Column="3" Text="STATUS" FontWeight="SemiBold" /><TextBlock Grid.Column="4" Text="PROFILE" FontWeight="SemiBold" />
          </Grid>
        </Border>
        <ListBox x:Name="lstMasterResults" Grid.Row="4" ItemsSource="{Binding lstResults}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" AutomationProperties.Name="Unified master search results">
          <ListBox.Styles><Style Selector="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /></Style></ListBox.Styles>
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:MasterSearchResultViewModel">
              <Border x:Name="bdrMasterSearchResult" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                      Margin="0" Padding="8,4">
              <Grid ColumnDefinitions="110,2*,3*,110,80" ColumnSpacing="12">
                <TextBlock Text="{Binding strType}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding strName}" TextWrapping="Wrap" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="{Binding strPrimaryInfo}" TextWrapping="Wrap" VerticalAlignment="Center" />
                <TextBlock Grid.Column="3" Text="{Binding strStatus}" VerticalAlignment="Center" />
                <Button x:Name="btnViewMasterResult" Grid.Column="4" Content="View" IsEnabled="False"
                        ToolTip.Tip="Profile navigation is not available yet." AutomationProperties.Name="{Binding strName, StringFormat='View profile for {0}'}" />
              </Grid>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>
    </TabItem>
  </TabControl>
</UserControl>
