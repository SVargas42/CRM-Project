<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HippoCrm.Desktop.ViewModels"
             x:Class="HippoCrm.Desktop.Views.DashboardView" x:DataType="vm:DashboardViewModel">
  <UserControl.DataTemplates>
    <DataTemplate DataType="{x:Type vm:MasterSearchFilterOption}" x:DataType="vm:MasterSearchFilterOption"><TextBlock Text="{Binding strLabel}" /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:OrganizationOptionViewModel}" x:DataType="vm:OrganizationOptionViewModel"><TextBlock Text="{Binding strName}" /></DataTemplate>
  </UserControl.DataTemplates>
  <UserControl.Styles>
    <Style Selector="Border.dashboardPlaceholder">
      <Setter Property="Padding" Value="24" />
      <Setter Property="Margin" Value="0,12,0,0" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
    </Style>
    <Style Selector="Border.metric">
      <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundAltHighBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseLowBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="12" />
    </Style>
    <Style Selector="TextBlock.eyebrow">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="LetterSpacing" Value="1" />
    </Style>
    <Style Selector="TextBlock.metricValue">
      <Setter Property="FontSize" Value="30" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
  </UserControl.Styles>
  <TabControl x:Name="tcDashboard" SelectedIndex="{Binding iSelectedTab, Mode=TwoWay}">
    <TabItem x:Name="tiOverview" Header="Overview">
      <ScrollViewer x:Name="scrDashboard" HorizontalScrollBarVisibility="Auto">
        <StackPanel Spacing="20" MinWidth="650" Width="{Binding $parent[ScrollViewer].Viewport.Width}">
          <Grid x:Name="gridMetrics" ColumnDefinitions="*,*,*,*,*,*" ColumnSpacing="8">
            <Border Classes="metric"><StackPanel Spacing="8"><TextBlock Text="CONTACTS" Classes="eyebrow" /><TextBlock Text="{Binding iContacts}" Classes="metricValue" /></StackPanel></Border>
            <Border Grid.Column="1" Classes="metric"><StackPanel Spacing="8"><TextBlock Text="ORGANIZATIONS" Classes="eyebrow" /><TextBlock Text="{Binding iOrganizations}" Classes="metricValue" /></StackPanel></Border>
            <Border Grid.Column="2" Classes="metric"><StackPanel Spacing="8"><TextBlock Text="AVAILABLE" Classes="eyebrow" /><TextBlock Text="{Binding iAvailable}" Classes="metricValue" /></StackPanel></Border>
            <Border Grid.Column="3" Classes="metric"><StackPanel Spacing="8"><TextBlock Text="ARCHIVED" Classes="eyebrow" /><TextBlock Text="{Binding iArchived}" Classes="metricValue" /></StackPanel></Border>
            <Border Grid.Column="4" Classes="metric"><StackPanel Spacing="8"><TextBlock Text="INTERACTIONS / 30D" Classes="eyebrow" /><TextBlock Text="{Binding iInteractions}" Classes="metricValue" /></StackPanel></Border>
            <Border Grid.Column="5" Classes="metric"><StackPanel Spacing="8"><TextBlock Text="FOLLOW-UPS DUE" Classes="eyebrow" /><TextBlock Text="{Binding iOverdue}" Classes="metricValue" /></StackPanel></Border>
          </Grid>

          <Grid ColumnDefinitions="2*,*" ColumnSpacing="16">
            <Border Classes="metric">
              <Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="12">
                <TextBlock Text="Weekly interaction activity" FontSize="17" FontWeight="SemiBold" />
                <Grid Grid.Row="1" ColumnDefinitions="*,90,2*" ColumnSpacing="16">
                  <TextBlock Text="PERIOD" Classes="eyebrow" /><TextBlock Grid.Column="1" Text="EVENTS" Classes="eyebrow" HorizontalAlignment="Right" /><TextBlock Grid.Column="2" Text="RELATIVE VOLUME" Classes="eyebrow" />
                </Grid>
                <ItemsControl x:Name="lstWeeklyActivity" Grid.Row="2" ItemsSource="{Binding lstActivity}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ActivityRowViewModel">
                      <Border Padding="0,12" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
                        <Grid ColumnDefinitions="*,90,2*" ColumnSpacing="16">
                          <TextBlock Text="{Binding strPeriod}" VerticalAlignment="Center" />
                          <TextBlock Grid.Column="1" Text="{Binding iInteractions}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                          <ProgressBar Grid.Column="2" Value="{Binding iPercent}" Maximum="100" Height="8" VerticalAlignment="Center"
                                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                                       AutomationProperties.Name="Relative weekly interaction volume" />
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Grid.Row="3" IsVisible="{Binding !bHasActivity}" Text="No activity is available for this workspace." TextWrapping="Wrap" />
              </Grid>
            </Border>
            <Border Grid.Column="1" Classes="metric">
              <StackPanel Spacing="16">
                <TextBlock Text="Workspace overview" FontSize="17" FontWeight="SemiBold" />
                <TextBlock Text="Review overdue relationships, confirm availability, and record interactions in the relevant profile." TextWrapping="Wrap" />
                <Separator />
                <TextBlock Text="ACCESS CONTROL" Classes="eyebrow" />
                <TextBlock Text="Totals reflect the records authorized for the signed-in account." TextWrapping="Wrap" />
                <TextBlock Text="LOCAL OPERATION" Classes="eyebrow" />
                <TextBlock Text="Encrypted local workspace. No cloud synchronization." TextWrapping="Wrap" />
              </StackPanel>
            </Border>
          </Grid>
        </StackPanel>
      </ScrollViewer>
    </TabItem>
    <TabItem x:Name="tiAnalytics" Header="Analytics">
      <TabControl x:Name="tcAnalyticsSub" SelectedIndex="{Binding iSelectedAnalyticsTab, Mode=TwoWay}" Margin="0,12,0,0">
        <TabItem x:Name="tiCombinedAnalytics" Header="Combined Analytics">
          <Border Classes="dashboardPlaceholder"><Grid x:Name="grdCombinedAnalyticsPlaceholder">
            <TextBlock Text="Combined Analytics Placeholder" HorizontalAlignment="Center" VerticalAlignment="Center"
                       TextWrapping="Wrap" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
          </Grid></Border>
        </TabItem>
        <TabItem x:Name="tiContactAnalytics" Header="Contact Analytics">
          <Border Classes="dashboardPlaceholder"><Grid x:Name="grdContactAnalyticsPlaceholder">
            <TextBlock Text="Contact Analytics Placeholder" HorizontalAlignment="Center" VerticalAlignment="Center"
                       TextWrapping="Wrap" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
          </Grid></Border>
        </TabItem>
        <TabItem x:Name="tiOrganizationAnalytics" Header="Organization Analytics">
          <Border Classes="dashboardPlaceholder"><Grid x:Name="grdOrganizationAnalyticsPlaceholder">
            <TextBlock Text="Organization Analytics Placeholder" HorizontalAlignment="Center" VerticalAlignment="Center"
                       TextWrapping="Wrap" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
          </Grid></Border>
        </TabItem>
      </TabControl>
    </TabItem>
    <TabItem x:Name="tiMasterSearch" Header="Master Search">
      <Grid x:Name="grdMasterSearch" DataContext="{Binding vmMasterSearch}" x:DataType="vm:MasterSearchViewModel"
            RowDefinitions="Auto,Auto,Auto,Auto,*" RowSpacing="12" Margin="0,12,0,0">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" IsEnabled="{Binding !bSearching}">
          <TextBox x:Name="txtMasterSearch" Text="{Binding strSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                   Watermark="Search contacts and organizations" FontSize="18" MinHeight="44" AutomationProperties.Name="Master search text" />
          <Button x:Name="btnMasterSearch" Grid.Column="1" Content="Search" Classes="primary" Command="{Binding cmdSearch}" />
        </Grid>
        <WrapPanel x:Name="pnlMasterFilters" Grid.Row="1" IsEnabled="{Binding !bSearching}">
          <StackPanel Spacing="6" Margin="0,0,12,8"><TextBlock Text="Tags" /><ComboBox x:Name="cmbFilterTags" Width="180" ItemsSource="{Binding lstTags}" SelectedItem="{Binding objSelectedTag, Mode=TwoWay}" AutomationProperties.Name="Filter by tag" ><ComboBox.ItemTemplate><DataTemplate x:DataType="vm:MasterSearchFilterOption"><Border CornerRadius="12" Padding="8,4" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"><TextBlock Text="{Binding strLabel}" TextAlignment="Center" FontSize="13" /></Border></DataTemplate></ComboBox.ItemTemplate></ComboBox></StackPanel>
          <StackPanel Spacing="6" Margin="0,0,12,8"><TextBlock Text="Status" /><ComboBox x:Name="cmbFilterStatus" Width="150" ItemsSource="{Binding lstStatuses}" SelectedItem="{Binding objSelectedStatus, Mode=TwoWay}" AutomationProperties.Name="Filter by status" /></StackPanel>
          <StackPanel Spacing="6" Margin="0,0,12,8"><TextBlock Text="Organizations" /><ComboBox x:Name="cmbFilterOrganizations" Width="220" ItemsSource="{Binding lstOrganizations}" SelectedItem="{Binding objSelectedOrganization, Mode=TwoWay}" AutomationProperties.Name="Filter by organization" /></StackPanel>
          <StackPanel Spacing="6" Margin="0,0,12,8"><TextBlock Text="Skills / Services" /><ComboBox x:Name="cmbFilterSkills" Width="180" ItemsSource="{Binding lstSkills}" SelectedItem="{Binding objSelectedSkill, Mode=TwoWay}" AutomationProperties.Name="Filter by skill or service" ><ComboBox.ItemTemplate><DataTemplate x:DataType="vm:MasterSearchFilterOption"><Border CornerRadius="12" Padding="8,4" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"><TextBlock Text="{Binding strLabel}" TextAlignment="Center" FontSize="13" /></Border></DataTemplate></ComboBox.ItemTemplate></ComboBox></StackPanel>
          <Button x:Name="btnClearMasterFilters" Content="Clear filters" Command="{Binding cmdClearFilters}" Margin="0,24,0,8" />
        </WrapPanel>
        <TextBlock x:Name="txtMasterSearchStatus" Grid.Row="2" Text="{Binding strSearchStatus}" AutomationProperties.LiveSetting="Polite"
                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
        <Border Grid.Row="3" Padding="8" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
          <Grid ColumnDefinitions="110,2*,3*,110,80" ColumnSpacing="12">
            <TextBlock Text="TYPE" FontWeight="SemiBold" /><TextBlock Grid.Column="1" Text="NAME" FontWeight="SemiBold" />
            <TextBlock Grid.Column="2" Text="PRIMARY INFO" FontWeight="SemiBold" /><TextBlock Grid.Column="3" Text="STATUS" FontWeight="SemiBold" /><TextBlock Grid.Column="4" Text="PROFILE" FontWeight="SemiBold" />
          </Grid>
        </Border>
        <ListBox x:Name="lstMasterResults" Grid.Row="4" ItemsSource="{Binding lstResults}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" AutomationProperties.Name="Unified master search results">
          <ListBox.Styles><Style Selector="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /></Style></ListBox.Styles>
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:MasterSearchResultViewModel">
              <Grid ColumnDefinitions="110,2*,3*,110,80" ColumnSpacing="12" Margin="0,6">
                <TextBlock Text="{Binding strType}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding strName}" TextWrapping="Wrap" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="{Binding strPrimaryInfo}" TextWrapping="Wrap" VerticalAlignment="Center" />
                <TextBlock Grid.Column="3" Text="{Binding strStatus}" VerticalAlignment="Center" />
                <Button x:Name="btnViewMasterResult" Grid.Column="4" Content="View" IsEnabled="False"
                        ToolTip.Tip="Profile navigation is not available yet." AutomationProperties.Name="{Binding strName, StringFormat='View profile for {0}'}" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>
    </TabItem>
  </TabControl>
</UserControl>
