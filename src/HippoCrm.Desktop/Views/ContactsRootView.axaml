<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HippoCrm.Desktop.ViewModels" xmlns:views="using:HippoCrm.Desktop.Views"
             x:Class="HippoCrm.Desktop.Views.ContactsRootView" x:DataType="vm:ContactsPageViewModel">
  <Grid x:Name="grdContactsRoot">
    <TabControl x:Name="tabContacts" Classes="WorkspaceSubTabs" SelectedIndex="{Binding iSelectedTab, Mode=TwoWay}" IsVisible="{Binding bLookup}">
      <TabItem x:Name="tabLookup" Header="Lookup">
        <Grid RowDefinitions="Auto,*" RowSpacing="12" Margin="0,12,0,0">
          <WrapPanel x:Name="pnlContactFilters">
            <StackPanel Spacing="6" Margin="0,0,12,8">
              <TextBlock Text="Name, email, or phone" />
              <TextBox x:Name="txtContactSearch" Width="220" Text="{Binding strSearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Search contacts" />
            </StackPanel>
            <StackPanel Spacing="6" Margin="0,0,12,8">
              <TextBlock Text="Skill contains" />
              <TextBox x:Name="txtContactSkill" Width="160" Text="{Binding vmWorkspace.strSkill, Mode=TwoWay}" AutomationProperties.Name="Skill contains" />
            </StackPanel>
            <StackPanel Spacing="6" Margin="0,0,12,8">
              <TextBlock Text="Availability" />
              <ComboBox x:Name="cboContactAvailability" SelectedIndex="{Binding vmWorkspace.iAvailability, Mode=TwoWay}" AutomationProperties.Name="Availability">
                <ComboBoxItem Content="Any availability" /><ComboBoxItem Content="Available" />
                <ComboBoxItem Content="Unavailable" /><ComboBoxItem Content="Unknown" />
              </ComboBox>
            </StackPanel>
            <CheckBox x:Name="chkContactArchived" Content="Archived records" IsChecked="{Binding vmWorkspace.bArchived, Mode=TwoWay}" Margin="0,20,12,8" />
            <Button x:Name="btnApplyContactFilters" Content="Apply filters" Command="{Binding vmWorkspace.cmdApplyFilters}" Margin="0,20,0,8" />
          </WrapPanel>
          <ListBox x:Name="lstContactLookup" Grid.Row="1" ItemsSource="{Binding lstRows}" AutomationProperties.Name="Contact lookup results"
                   Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.Styles>
              <Style Selector="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /></Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:ContactLookupRowViewModel">
                <Border x:Name="bdrContactLookupResult" BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" CornerRadius="12" Margin="0,0,0,10" Padding="16">
                 <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="16" RowSpacing="12">
                  <TextBlock Text="{Binding strName}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" />
                  <Button x:Name="btnViewProfile" Grid.Column="1" Content="View Profile" Classes="primary" Command="{Binding cmdViewProfile}" AutomationProperties.Name="{Binding strName, StringFormat='View profile for {0}'}" />
                  <Grid Grid.Row="1" Grid.ColumnSpan="2" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="20" RowSpacing="10">
                   <StackPanel Spacing="3"><TextBlock Text="Status" Classes="fieldLabel" /><TextBlock Text="{Binding strStatus}" TextWrapping="Wrap" /></StackPanel>
                   <StackPanel Grid.Column="1" Spacing="3"><TextBlock Text="Organization" Classes="fieldLabel" /><TextBlock Text="{Binding strOrganization}" TextWrapping="Wrap" /></StackPanel>
                   <StackPanel Grid.Row="1" Spacing="3"><TextBlock Text="Email" Classes="fieldLabel" /><TextBlock Text="{Binding strEmail}" TextWrapping="Wrap" /></StackPanel>
                   <StackPanel Grid.Row="1" Grid.Column="1" Spacing="3"><TextBlock Text="Phone" Classes="fieldLabel" /><TextBlock Text="{Binding strPhone}" TextWrapping="Wrap" /></StackPanel>
                  </Grid>
                  <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Spacing="5">
                   <TextBlock Text="Tags" Classes="fieldLabel" />
                   <Border x:Name="bdrContactTags" ClipToBounds="True" ToolTip.Tip="{Binding strAllTags}" AutomationProperties.Name="{Binding strAllTags}">
                    <views:TokenChipsView x:Name="lstContactTags" lstValues="{Binding lstTags}" />
                   </Border>
                  </StackPanel>
                 </Grid>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </TabItem>
      <TabItem x:Name="tabAddContact" Header="Add Contact" IsEnabled="{Binding vmWorkspace.bCanCreate}">
        <views:ContactEditorView x:Name="vAddContact" DataContext="{Binding vmWorkspace}" Margin="0,12,0,0" />
      </TabItem>
    </TabControl>
    <ContentControl x:Name="ctrContactProfile" Content="{Binding vmProfile}" IsVisible="{Binding bProfile}"
                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
      <ContentControl.ContentTemplate>
        <DataTemplate x:DataType="vm:ContactProfileViewModel">
          <views:ContactProfileView x:Name="vContactProfile" />
        </DataTemplate>
      </ContentControl.ContentTemplate>
    </ContentControl>
    <ContentControl x:Name="ctrEditContact" Content="{Binding vmEdit}" IsVisible="{Binding bEditing}"
                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
      <ContentControl.ContentTemplate>
        <DataTemplate x:DataType="vm:EditContactViewModel"><views:EditContactView x:Name="vEditContact" /></DataTemplate>
      </ContentControl.ContentTemplate>
    </ContentControl>
  </Grid>
</UserControl>
