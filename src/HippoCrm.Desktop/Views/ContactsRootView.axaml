<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HippoCrm.Desktop.ViewModels" xmlns:controls="using:HippoCrm.Desktop" xmlns:views="using:HippoCrm.Desktop.Views"
             x:Class="HippoCrm.Desktop.Views.ContactsRootView" x:DataType="vm:ContactsPageViewModel">
  <Grid x:Name="grdContactsRoot">
    <TabControl x:Name="tabContacts" Classes="WorkspaceSubTabs" SelectedIndex="{Binding iSelectedTab, Mode=TwoWay}" IsVisible="{Binding bLookup}">
      <TabItem x:Name="tabLookup" Header="Lookup">
        <Grid RowDefinitions="Auto,Auto,*" RowSpacing="14" Margin="0,12,0,0">
          <Border x:Name="pnlContactFilters" MaxWidth="1260" HorizontalAlignment="Stretch" Padding="18"
                  BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                  Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" CornerRadius="14">
            <StackPanel Spacing="12">
              <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="6">
                <TextBlock Text="Name, email, or phone" TextWrapping="Wrap" />
                <TextBlock Grid.Column="1" Text="Skill contains" TextWrapping="Wrap" />
                <TextBlock Grid.Column="2" Text="Availability" TextWrapping="Wrap" />
                <controls:CrmTextBox x:Name="txtContactSearch" Classes="fieldSearch" Grid.Row="1" Text="{Binding strSearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         HorizontalAlignment="Stretch" AutomationProperties.Name="Search contacts" />
                <controls:CrmTextBox x:Name="txtContactSkill" Classes="fieldStandard" Grid.Row="1" Grid.Column="1" Text="{Binding vmWorkspace.strSkill, Mode=TwoWay}"
                         HorizontalAlignment="Stretch" AutomationProperties.Name="Skill contains" />
                <ComboBox x:Name="cboContactAvailability" Grid.Row="1" Grid.Column="2" SelectedIndex="{Binding vmWorkspace.iAvailability, Mode=TwoWay}"
                          HorizontalAlignment="Stretch" AutomationProperties.Name="Availability">
                    <ComboBoxItem Content="Any availability" /><ComboBoxItem Content="Available" />
                    <ComboBoxItem Content="Unavailable" /><ComboBoxItem Content="Unknown" />
                </ComboBox>
              </Grid>
              <Grid ColumnDefinitions="*,*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="6">
                <CheckBox x:Name="chkContactArchived" Grid.RowSpan="2" Content="Archived records"
                          IsChecked="{Binding vmWorkspace.bArchived, Mode=TwoWay}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="Status" />
                <ComboBox x:Name="cboContactStatus" Grid.Row="1" Grid.Column="1" SelectedIndex="{Binding vmWorkspace.iContactStatus, Mode=TwoWay}"
                          HorizontalAlignment="Stretch" AutomationProperties.Name="Contact lifecycle status">
                  <ComboBoxItem Content="Active" /><ComboBoxItem Content="Inactive" /><ComboBoxItem Content="Retired" /><ComboBoxItem Content="Deceased" />
                </ComboBox>
                <Button x:Name="btnApplyContactFilters" Grid.Column="2" Grid.RowSpan="2" Content="Apply filters"
                        Command="{Binding vmWorkspace.cmdApplyFilters}" Classes="primary" VerticalAlignment="Center" />
              </Grid>
              <TextBlock x:Name="txtContactFilterSummary" Text="{Binding strFilterSummary}"
                         Classes="muted" AutomationProperties.LiveSetting="Polite" />
            </StackPanel>
          </Border>
          <Border Grid.Row="1" Padding="8,6" BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                  Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" CornerRadius="10">
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
              <TextBlock Text="{Binding vmWorkspace.strLookupPageScope}" VerticalAlignment="Center" />
              <Button Grid.Column="1" Content="Previous" AutomationProperties.Name="Previous contacts page"
                      Command="{Binding vmWorkspace.cmdPreviousLookupPage}" IsEnabled="{Binding vmWorkspace.bCanGoToPreviousLookupPage}" />
              <Button Grid.Column="2" Content="Next" AutomationProperties.Name="Next contacts page"
                      Command="{Binding vmWorkspace.cmdNextLookupPage}" IsEnabled="{Binding vmWorkspace.bCanGoToNextLookupPage}" />
            </Grid>
          </Border>
          <Grid Grid.Row="2">
          <ListBox x:Name="lstContactLookup" ItemsSource="{Binding lstRows}" AutomationProperties.Name="Contact lookup results"
                   Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.Styles>
              <Style Selector="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /></Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:ContactLookupRowViewModel">
                <Border x:Name="bdrContactLookupResult" BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" CornerRadius="12" Margin="0,0,0,10" Padding="16">
                 <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="16" RowSpacing="12">
                  <TextBlock Text="{Binding strName}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" />
                  <Button x:Name="btnViewProfile" Grid.Column="1" Content="View Profile" Classes="primary" Command="{Binding cmdViewProfile}" AutomationProperties.Name="{Binding strName, StringFormat='View profile for {0}'}" />
                  <Grid Grid.Row="1" Grid.ColumnSpan="2" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="20" RowSpacing="10">
                   <StackPanel Spacing="3"><TextBlock Text="Status" Classes="fieldLabel" /><TextBlock Text="{Binding strStatus}" TextWrapping="Wrap" /></StackPanel>
                   <StackPanel Grid.Column="1" Spacing="3"><TextBlock Text="Organization" Classes="fieldLabel" /><TextBlock Text="{Binding strOrganization}" TextWrapping="Wrap" /></StackPanel>
                   <StackPanel Grid.Row="1" Spacing="3"><TextBlock Text="Email" Classes="fieldLabel" /><TextBlock Text="{Binding strEmail}" TextWrapping="Wrap" /></StackPanel>
                   <StackPanel Grid.Row="1" Grid.Column="1" Spacing="3"><TextBlock Text="Phone" Classes="fieldLabel" /><TextBlock Text="{Binding strPhone}" TextWrapping="Wrap" /></StackPanel>
                  </Grid>
                  <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Spacing="5">
                   <TextBlock Text="Tags" Classes="fieldLabel" />
                   <Border x:Name="bdrContactTags" ClipToBounds="True" ToolTip.Tip="{Binding strAllTags}" AutomationProperties.Name="{Binding strAllTags}">
                    <views:TokenChipsView x:Name="lstContactTags" lstValues="{Binding lstTags}" />
                   </Border>
                  </StackPanel>
                 </Grid>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <Border x:Name="bdrContactEmptyState" IsVisible="{Binding bShowEmptyState}" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                  BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12"
                  Margin="0,0,0,10" Padding="24" IsHitTestVisible="False">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6" MaxWidth="420">
              <TextBlock Text="{Binding strEmptyStateTitle}" FontSize="17" FontWeight="SemiBold" TextAlignment="Center" />
              <TextBlock Text="{Binding strEmptyStateMessage}" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                         TextWrapping="Wrap" TextAlignment="Center" />
            </StackPanel>
          </Border>
          <StackPanel IsVisible="{Binding bFiltering}" VerticalAlignment="Top" Spacing="4" IsHitTestVisible="False">
            <ProgressBar IsIndeterminate="True" Height="3" AutomationProperties.Name="Filtering contacts" />
            <TextBlock Text="Filtering contacts…" Classes="muted" FontSize="12" />
          </StackPanel>
          </Grid>
        </Grid>
      </TabItem>
      <TabItem x:Name="tabAddContact" Header="Add Contact" IsEnabled="{Binding vmWorkspace.bCanCreate}">
        <views:AddContactFormView x:Name="vAddContact" DataContext="{Binding vmWorkspace}" Margin="0,12,0,0" HorizontalAlignment="Stretch" />
      </TabItem>
    </TabControl>
    <ContentControl x:Name="ctrContactProfile" Content="{Binding vmProfile}" IsVisible="{Binding bProfile}"
                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
      <ContentControl.ContentTemplate>
        <DataTemplate x:DataType="vm:ContactProfileViewModel">
          <views:ContactProfileView x:Name="vContactProfile" />
        </DataTemplate>
      </ContentControl.ContentTemplate>
    </ContentControl>
    <ContentControl x:Name="ctrEditContact" Content="{Binding vmEdit}" IsVisible="{Binding bEditing}"
                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
      <ContentControl.ContentTemplate>
        <DataTemplate x:DataType="vm:EditContactViewModel"><views:EditContactView x:Name="vEditContact" /></DataTemplate>
      </ContentControl.ContentTemplate>
    </ContentControl>
  </Grid>
</UserControl>
