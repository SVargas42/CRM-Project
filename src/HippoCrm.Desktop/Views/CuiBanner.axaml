<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="HippoCrm.Desktop.Views.CuiBanner">
  <Border Padding="12,8" BorderThickness="0,1"
          Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
          BorderBrush="{DynamicResource SystemControlForegroundBaseHighBrush}">
    <TextBlock x:Name="txtCuiMarking" Text="CUI — CONTROLLED UNCLASSIFIED INFORMATION"
               FontSize="14" FontWeight="Bold" TextWrapping="Wrap" TextAlignment="Center"
               Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"
               AutomationProperties.Name="CUI. Controlled Unclassified Information." />
  </Border>
</UserControl>
