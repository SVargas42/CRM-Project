<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HippoCrm.Desktop.ViewModels" xmlns:controls="using:HippoCrm.Desktop" xmlns:views="using:HippoCrm.Desktop.Views" xmlns:core="using:HippoCrm.Core"
             x:Class="HippoCrm.Desktop.Views.AddContactFormView" x:DataType="vm:MainWindowViewModel">
  <ScrollViewer x:Name="scrAddContact" IsEnabled="{Binding bCanEditContact}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Left">
    <StackPanel x:Name="pnlAddContact" Spacing="20" Margin="0,0,12,0" MaxWidth="1260" HorizontalAlignment="Left">
      <StackPanel x:Name="pnlAddContactName" Spacing="12" Width="520" HorizontalAlignment="Left">
        <TextBlock Text="Name" Classes="sectionHeading" />
        <StackPanel x:Name="pnlPrefixName" Spacing="6"><TextBlock Text="Prefix" Classes="fieldLabel" /><ComboBox x:Name="cboContactPrefix" Width="220" HorizontalAlignment="Left" ItemsSource="{Binding lstPrefixes}" SelectedItem="{Binding objContact.Prefix, Mode=TwoWay}" AutomationProperties.Name="Prefix" /></StackPanel>
        <StackPanel x:Name="pnlFirstName" Spacing="6"><TextBlock Text="First name *" Classes="fieldLabel" /><controls:CrmTextBox x:Name="txtFirstName" Width="420" HorizontalAlignment="Left" Classes="fieldStandard" Tag="First name *" Text="{Binding objContact.FirstName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding !bCanEditContact}" AutomationProperties.Name="First name *" /></StackPanel>
        <StackPanel x:Name="pnlMiddleNames" Spacing="6">
          <TextBlock Text="Middle name" Classes="fieldLabel" />
          <ItemsControl x:Name="lstAddContactMiddleNames" ItemsSource="{Binding lstMiddleNameFields}" AutomationProperties.Name="Contact middle names">
            <ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:MiddleNameFieldViewModel">
              <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="8" Margin="0,0,0,8">
                <controls:CrmTextBox x:Name="txtAddContactMiddleName" Width="420" HorizontalAlignment="Left" Classes="fieldStandard" Tag="Middle name" Text="{Binding strValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Middle name" />
                <Button x:Name="btnAddMiddleName" Grid.Column="1" Content="Add" Click="OnAddMiddleName" IsVisible="{Binding !bCanRemove}" Classes="inlineAction" AutomationProperties.Name="Add another middle name" />
                <Button Grid.Column="1" Content="Remove" Command="{Binding cmdRemove}" IsVisible="{Binding bCanRemove}" Classes="inlineAction" AutomationProperties.Name="Remove middle name" />
              </Grid>
            </DataTemplate></ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
        <StackPanel x:Name="pnlLastName" Spacing="6"><TextBlock Text="Last name *" Classes="fieldLabel" /><controls:CrmTextBox x:Name="txtLastName" Width="420" HorizontalAlignment="Left" Classes="fieldStandard" Tag="Last name *" Text="{Binding objContact.LastName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding !bCanEditContact}" AutomationProperties.Name="Last name *" /></StackPanel>
        <StackPanel x:Name="pnlSuffixName" Spacing="6"><TextBlock Text="Suffix" Classes="fieldLabel" /><ComboBox x:Name="cboContactSuffix" Width="220" HorizontalAlignment="Left" ItemsSource="{Binding lstSuffixes}" SelectedItem="{Binding objContact.Suffix, Mode=TwoWay}" AutomationProperties.Name="Suffix" /></StackPanel>
      </StackPanel>

      <StackPanel Spacing="12">
        <TextBlock Text="Contact Information" Classes="sectionHeading" />
        <StackPanel Spacing="8" IsEnabled="{Binding bCanEditContact}">
          <StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="Address" Classes="fieldLabel" VerticalAlignment="Center" /><Button x:Name="btnAddContactAddress" Content="Add" Command="{Binding cmdAddContactAddress}" Classes="inlineAction" AutomationProperties.Name="Add another address" /></StackPanel>
          <ItemsControl x:Name="lstAddContactAddresses" ItemsSource="{Binding lstNewContactAddresses}" AutomationProperties.Name="Contact addresses">
          <ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:ContactAddressEntryViewModel">
              <StackPanel Spacing="8" Margin="0,0,0,10">
                <StackPanel Spacing="5"><TextBlock Text="Type" Classes="fieldLabel" /><ComboBox Width="220" HorizontalAlignment="Left" ItemsSource="{Binding lstAddressTypes}" SelectedItem="{Binding strType, Mode=TwoWay}" AutomationProperties.Name="Address type" /></StackPanel>
                <StackPanel Spacing="5"><TextBlock Text="Street 1" Classes="fieldLabel" /><controls:CrmTextBox x:Name="txtAddContactStreet1" Width="420" HorizontalAlignment="Left" Classes="fieldStandard" Text="{Binding strStreet1, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Street 1" /></StackPanel>
                <StackPanel Spacing="5"><TextBlock Text="Street 2" Classes="fieldLabel" /><controls:CrmTextBox x:Name="txtAddContactStreet2" Width="420" HorizontalAlignment="Left" Classes="fieldStandard" Text="{Binding strStreet2, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Street 2" /></StackPanel>
                <StackPanel Spacing="5"><TextBlock Text="City" Classes="fieldLabel" /><controls:CrmTextBox x:Name="txtAddContactCity" Width="420" HorizontalAlignment="Left" Classes="fieldStandard" Text="{Binding strCity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="City" /></StackPanel>
                <StackPanel Spacing="5"><TextBlock Text="State" Classes="fieldLabel" /><controls:CrmTextBox x:Name="txtAddContactState" Width="220" HorizontalAlignment="Left" Classes="fieldCompact" Text="{Binding strState, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="State" /></StackPanel>
                <StackPanel Spacing="5"><TextBlock Text="ZIP" Classes="fieldLabel" /><controls:CrmTextBox x:Name="txtAddContactZip" Width="220" HorizontalAlignment="Left" Classes="fieldCompact" Text="{Binding strZip, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="ZIP" /></StackPanel>
                <StackPanel Spacing="5"><TextBlock Text="Nation" Classes="fieldLabel" /><controls:CrmTextBox x:Name="txtAddContactNation" Width="220" HorizontalAlignment="Left" Classes="fieldCompact" Text="{Binding strNation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Nation" /></StackPanel>
                <Button Content="Remove address" Command="{Binding cmdRemove}" IsVisible="{Binding bCanRemove}" Classes="inlineAction" HorizontalAlignment="Left" />
              </StackPanel>
            </DataTemplate></ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
        <StackPanel Spacing="6" DataContext="{Binding vmNewContactEmails}" x:DataType="vm:MultiValueFieldViewModel">
          <TextBlock Text="Email" Classes="fieldLabel" />
          <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="8" HorizontalAlignment="Left"><controls:CrmTextBox x:Name="txtNewContactEmail" Width="420" HorizontalAlignment="Left" Classes="fieldStandard" Text="{Binding strNewValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Watermark="Email address" AutomationProperties.Name="New email address" /><Button x:Name="btnAddContactEmail" Grid.Column="1" Content="Add" Command="{Binding cmdAdd}" Classes="inlineAction" /></Grid>
          <ItemsControl ItemsSource="{Binding lstValues}" IsVisible="{Binding bHasValues}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:MultiValueFieldViewModel+EntryViewModel"><Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="8" Margin="0,0,0,4"><TextBlock Text="{Binding strValue}" VerticalAlignment="Center" /><Button Grid.Column="1" Content="Remove" Command="{Binding cmdRemove}" Classes="inlineAction" /></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
          <TextBlock Text="{Binding strError}" IsVisible="{Binding bHasError}" Classes="muted" />
        </StackPanel>
        <StackPanel Spacing="6" DataContext="{Binding vmNewContactPhones}" x:DataType="vm:MultiValueFieldViewModel">
          <TextBlock Text="Phone" Classes="fieldLabel" />
          <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="8" HorizontalAlignment="Left"><controls:CrmTextBox x:Name="txtNewContactPhone" Width="220" HorizontalAlignment="Left" Classes="fieldCompact" Text="{Binding strNewValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Watermark="Phone number" AutomationProperties.Name="New phone number" /><Button x:Name="btnAddContactPhone" Grid.Column="1" Content="Add" Command="{Binding cmdAdd}" Classes="inlineAction" /></Grid>
          <ItemsControl ItemsSource="{Binding lstValues}" IsVisible="{Binding bHasValues}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:MultiValueFieldViewModel+EntryViewModel"><Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="8" Margin="0,0,0,4"><TextBlock Text="{Binding strValue}" VerticalAlignment="Center" /><Button Grid.Column="1" Content="Remove" Command="{Binding cmdRemove}" Classes="inlineAction" /></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
          <TextBlock Text="{Binding strError}" IsVisible="{Binding bHasError}" Classes="muted" />
        </StackPanel>
        <StackPanel Spacing="8">
          <TextBlock Text="Social Media" Classes="fieldLabel" />
          <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="8" HorizontalAlignment="Left">
            <ComboBox x:Name="cboSocialMediaPlatform" Width="220" ItemsSource="{Binding lstSocialMediaPlatforms}" SelectedItem="{Binding strNewSocialMediaPlatform, Mode=TwoWay}" AutomationProperties.Name="Social media type" />
            <Button Grid.Column="1" Content="Add" Click="OnAddSocialMediaPlatform" Classes="inlineAction" AutomationProperties.Name="Add a new social media platform" />
          </Grid>
          <TextBlock Text="URL" Classes="fieldLabel" />
          <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="8" HorizontalAlignment="Left">
            <controls:CrmTextBox Width="360" Classes="fieldStandard" Text="{Binding strNewSocialMediaValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Watermark="Profile or URL" AutomationProperties.Name="Social media profile or URL" />
            <Button Grid.Column="1" Content="Add" Command="{Binding cmdAddContactSocialMedia}" Classes="inlineAction" AutomationProperties.Name="Add social media URL" />
          </Grid>
          <ItemsControl ItemsSource="{Binding lstNewContactSocialMedia}" IsVisible="{Binding bHasSocialMedia}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:SocialMediaEntryViewModel"><Grid ColumnDefinitions="Auto,Auto,Auto" ColumnSpacing="8" Margin="0,0,0,4"><TextBlock Text="{Binding strPlatform}" VerticalAlignment="Center" /><TextBlock Grid.Column="1" Text="{Binding strValue}" VerticalAlignment="Center" /><Button Grid.Column="2" Content="Remove" Command="{Binding cmdRemove}" Classes="inlineAction" /></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
        </StackPanel>
      </StackPanel>

      <StackPanel Spacing="12">
        <TextBlock Text="Personal Information" Classes="sectionHeading" />
        <StackPanel Spacing="6" DataContext="{Binding vmNewContactSpouse}" x:DataType="vm:MultiValueFieldViewModel"><TextBlock Text="Spouse" Classes="fieldLabel" /><Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="8" HorizontalAlignment="Left"><controls:CrmTextBox Width="420" Classes="fieldStandard" Text="{Binding strNewValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Watermark="Name" AutomationProperties.Name="Spouse" /><Button Grid.Column="1" Content="Add" Command="{Binding cmdAdd}" Classes="inlineAction" /></Grid><ItemsControl ItemsSource="{Binding lstValues}" IsVisible="{Binding bHasValues}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:MultiValueFieldViewModel+EntryViewModel"><Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="8"><TextBlock Text="{Binding strValue}" VerticalAlignment="Center" /><Button Grid.Column="1" Content="Remove" Command="{Binding cmdRemove}" Classes="inlineAction" /></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel>
        <StackPanel Spacing="6" DataContext="{Binding vmNewContactChildren}" x:DataType="vm:MultiValueFieldViewModel"><TextBlock Text="Children" Classes="fieldLabel" /><Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="8" HorizontalAlignment="Left"><controls:CrmTextBox Width="420" Classes="fieldStandard" Text="{Binding strNewValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Watermark="Name" AutomationProperties.Name="Child name" /><Button Grid.Column="1" Content="Add" Command="{Binding cmdAdd}" Classes="inlineAction" /></Grid><ItemsControl ItemsSource="{Binding lstValues}" IsVisible="{Binding bHasValues}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:MultiValueFieldViewModel+EntryViewModel"><Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="8"><TextBlock Text="{Binding strValue}" VerticalAlignment="Center" /><Button Grid.Column="1" Content="Remove" Command="{Binding cmdRemove}" Classes="inlineAction" /></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel>
        <StackPanel Spacing="6" DataContext="{Binding vmNewContactFamily}" x:DataType="vm:MultiValueFieldViewModel"><TextBlock Text="Extended Family" Classes="fieldLabel" /><Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="8" HorizontalAlignment="Left"><controls:CrmTextBox Width="420" Classes="fieldStandard" Text="{Binding strNewValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Watermark="Name" AutomationProperties.Name="Extended family member" /><Button Grid.Column="1" Content="Add" Command="{Binding cmdAdd}" Classes="inlineAction" /></Grid><ItemsControl ItemsSource="{Binding lstValues}" IsVisible="{Binding bHasValues}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:MultiValueFieldViewModel+EntryViewModel"><Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="8"><TextBlock Text="{Binding strValue}" VerticalAlignment="Center" /><Button Grid.Column="1" Content="Remove" Command="{Binding cmdRemove}" Classes="inlineAction" /></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel>
        <StackPanel Spacing="6" DataContext="{Binding vmNewContactFriends}" x:DataType="vm:MultiValueFieldViewModel"><TextBlock Text="Friends" Classes="fieldLabel" /><Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="8" HorizontalAlignment="Left"><controls:CrmTextBox Width="420" Classes="fieldStandard" Text="{Binding strNewValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Watermark="Name" AutomationProperties.Name="Friend name" /><Button Grid.Column="1" Content="Add" Command="{Binding cmdAdd}" Classes="inlineAction" /></Grid><ItemsControl ItemsSource="{Binding lstValues}" IsVisible="{Binding bHasValues}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:MultiValueFieldViewModel+EntryViewModel"><Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="8"><TextBlock Text="{Binding strValue}" VerticalAlignment="Center" /><Button Grid.Column="1" Content="Remove" Command="{Binding cmdRemove}" Classes="inlineAction" /></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel>
      </StackPanel>

      <StackPanel Spacing="12">
        <TextBlock Text="Extra Information" Classes="sectionHeading" />
        <StackPanel Spacing="6"><TextBlock Text="Organization" Classes="fieldLabel" /><ItemsControl x:Name="lstAddContactOrganizations" ItemsSource="{Binding lstAddedOrganizations}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:OrganizationSelectionViewModel"><Border CornerRadius="8" Padding="8,4" Margin="0,0,6,6" Background="{DynamicResource SystemControlBackgroundAltHighBrush}" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="1"><StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="{Binding strName}" VerticalAlignment="Center" /><Button Content="Remove" Command="{Binding cmdRemove}" Classes="inlineAction" /></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><Button x:Name="btnShowOrganizationLookup" Content="Add Organization" Classes="primary" Command="{Binding cmdShowOrganizationLookup}" IsEnabled="{Binding bCanEditContact}" HorizontalAlignment="Left" /><StackPanel x:Name="pnlOrganizationLookup" Spacing="6" IsVisible="{Binding bOrganizationLookup}"><AutoCompleteBox x:Name="acbOrganizationSearch" Watermark="Search organizations" Text="{Binding strOrganizationSearch, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" SelectedItem="{Binding objOrganizationToAdd, Mode=TwoWay}" AsyncPopulator="{Binding fnPopulateOrganizations}" FilterMode="None" ValueMemberBinding="{ReflectionBinding strName}" MinimumPrefixLength="1" MinimumPopulateDelay="0" IsTextCompletionEnabled="False" Width="420" HorizontalAlignment="Left" AutomationProperties.Name="Search available organizations"><AutoCompleteBox.ItemTemplate><DataTemplate x:DataType="vm:OrganizationOptionViewModel"><TextBlock Text="{Binding strName}" /></DataTemplate></AutoCompleteBox.ItemTemplate></AutoCompleteBox><Button x:Name="btnConfirmContactOrganization" Content="Add organization" Command="{Binding cmdAddContactOrganization}" IsEnabled="{Binding bCanAddOrganization}" HorizontalAlignment="Left" /></StackPanel></StackPanel>
        <StackPanel Spacing="6"><TextBlock Text="Tags" Classes="fieldLabel" /><views:TokenChipsView x:Name="ctrContactTags" lstValues="{Binding lstContactTags}" /><Button Classes="inlineAction" x:Name="btnManageContactTags" Content="Manage Tags" Click="OnManageTags" IsEnabled="{Binding bCanEditContact}" HorizontalAlignment="Left" /></StackPanel>
        <StackPanel Spacing="6"><TextBlock Text="Skills" Classes="fieldLabel" /><views:TokenChipsView x:Name="ctrContactSkills" lstValues="{Binding lstContactSkills}" /><Button Classes="inlineAction" x:Name="btnManageContactSkills" Content="Manage Skills" Click="OnManageSkills" IsEnabled="{Binding bCanEditContact}" HorizontalAlignment="Left" /></StackPanel>
        <StackPanel Spacing="6"><TextBlock Text="Status" Classes="fieldLabel" /><ComboBox x:Name="cboStatus" SelectedItem="{Binding objContact.Status, Mode=TwoWay}" IsEnabled="{Binding bCanEditContact}" Width="260" HorizontalAlignment="Left" AutomationProperties.Name="Status"><ComboBox.Items><x:Static Member="core:RecordStatus.Active" /><x:Static Member="core:RecordStatus.Inactive" /><x:Static Member="core:RecordStatus.Retired" /><x:Static Member="core:RecordStatus.Deceased" /></ComboBox.Items></ComboBox></StackPanel>
        <StackPanel Spacing="6"><TextBlock Text="Contract Availability" Classes="fieldLabel" /><ComboBox x:Name="cboAvailability" SelectedItem="{Binding objContact.Availability, Mode=TwoWay}" IsEnabled="{Binding bCanEditContact}" Width="260" HorizontalAlignment="Left" AutomationProperties.Name="Contract availability"><ComboBox.Items><x:Static Member="core:Availability.Available" /><x:Static Member="core:Availability.Unavailable" /><x:Static Member="core:Availability.Unknown" /></ComboBox.Items></ComboBox></StackPanel>
      </StackPanel>
      <Button x:Name="btnSaveContact" Content="Save contact" Classes="primary" Command="{Binding cmdSaveContact}" IsEnabled="{Binding bCanEditContact}" HorizontalAlignment="Left" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
