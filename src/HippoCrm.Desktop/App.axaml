<Application xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="HippoCrm.Desktop.App" RequestedThemeVariant="Light">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://HippoCrm/Themes/TacticalResources.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme />
    <Style Selector="Window"><Setter Property="FontFamily" Value="{DynamicResource TacticalFontFamily}" /><Setter Property="FontSize" Value="14" /></Style>
    <Style Selector="Button"><Setter Property="Padding" Value="16,10" /><Setter Property="CornerRadius" Value="7" /></Style>
    <Style Selector="Button.primary"><Setter Property="Background" Value="{DynamicResource TacticalAccentBrush}" /><Setter Property="Foreground" Value="{DynamicResource TacticalOnAccentBrush}" /></Style>
    <Style Selector="Button.nav"><Setter Property="HorizontalAlignment" Value="Stretch" /><Setter Property="HorizontalContentAlignment" Value="Left" /><Setter Property="Background" Value="{DynamicResource SystemControlBackgroundAltHighBrush}" /><Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" /><Setter Property="BorderThickness" Value="0" /></Style>
    <Style Selector="TextBox"><Setter Property="CornerRadius" Value="6" /><Setter Property="MinHeight" Value="38" /></Style>
    <Style Selector="ComboBox"><Setter Property="HorizontalAlignment" Value="Stretch" /><Setter Property="MinHeight" Value="38" /></Style>
    <Style Selector="TextBlock.muted"><Setter Property="Opacity" Value="0.65" /></Style>
    <Style Selector="TextBlock.title"><Setter Property="FontSize" Value="30" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
    <Style Selector="TextBlock.section"><Setter Property="FontSize" Value="19" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
    <Style Selector="TabItem"><Setter Property="FontSize" Value="14" /><Setter Property="Padding" Value="8,10" /></Style>
  </Application.Styles>
</Application>
