<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Only this theme dictionary owns color values; controls consume semantic DynamicResources.
       Accent text contrast: Light 10.10:1; Dark 10.11:1 (sRGB WCAG luminance calculation).
       Accent is reserved for primary actions and the selected navigation destination. -->
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
      <SolidColorBrush x:Key="TacticalAccentBrush" Color="#17446C" />
      <SolidColorBrush x:Key="TacticalOnAccentBrush" Color="#FFFFFF" />
    </ResourceDictionary>
    <ResourceDictionary x:Key="Dark">
      <SolidColorBrush x:Key="TacticalAccentBrush" Color="#9BCBFA" />
      <SolidColorBrush x:Key="TacticalOnAccentBrush" Color="#101C28" />
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>
  <FontFamily x:Key="TacticalFontFamily">avares://Avalonia.Fonts.Inter/Assets#Inter</FontFamily>
</ResourceDictionary>
