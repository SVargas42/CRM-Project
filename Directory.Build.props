<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest</AnalysisLevel>
    <!-- Local Release builds may report ImageSharp licensing failures as warnings.
         Set false explicitly to require successful vendor validation. -->
    <bImageSharpLicenseWarningsOnly Condition="'$(bImageSharpLicenseWarningsOnly)' == '' and '$(Configuration)' == 'Release'">true</bImageSharpLicenseWarningsOnly>
    <bImageSharpLicenseWarningsOnly Condition="'$(bImageSharpLicenseWarningsOnly)' == ''">false</bImageSharpLicenseWarningsOnly>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode>true</RestoreLockedMode>
    <NuGetAudit>false</NuGetAudit>
    <RestorePackagesPath>$([System.IO.Path]::Combine('$(MSBuildThisFileDirectory)', 'artifacts', 'verified-packages'))</RestorePackagesPath>
    <!-- Optional, genuinely provisioned offline license. Do not replace an explicit
         license property or key; a blank file is still rejected by the vendor task. -->
    <SixLaborsLicenseFile Condition="'$(SixLaborsLicenseFile)' == '' and '$(SixLaborsLicenseKey)' == '' and Exists('$(MSBuildThisFileDirectory)sixlabors.lic')">$(MSBuildThisFileDirectory)sixlabors.lic</SixLaborsLicenseFile>
  </PropertyGroup>
</Project>
