<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Paths are relative to this file. Populate only with approved, verified packages. -->
  <packageSources>
    <clear />
    <add key="LocalPackages" value="LocalPackages" />
  </packageSources>
  <disabledPackageSources><clear /></disabledPackageSources>
  <fallbackPackageFolders><clear /></fallbackPackageFolders>
  <auditSources><clear /></auditSources>
  <config>
    <add key="signatureValidationMode" value="require" />
  </config>
  <trustedSigners>
    <!-- Repository identity only; package retrieval remains local-only. -->
    <repository name="NuGet" serviceIndex="https://api.nuget.org/v3/index.json">
      <certificate fingerprint="1F4B311D9ACC115C8DC8018B5A49E00FCE6DA8E2855F9F014CA6F34570BC482D" hashAlgorithm="SHA256" allowUntrustedRoot="false" />
    </repository>
  </trustedSigners>
</configuration>
